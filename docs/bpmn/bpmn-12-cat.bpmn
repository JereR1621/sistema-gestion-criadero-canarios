        <di:waypoint x="1486" y="1360"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="CAT_A_catalogo_di" bpmnElement="CAT_A_catalogo">
        <dc:Bounds x="1310" y="537.0" width="330" height="286.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="CAT_A_catalogo_asoc_di" bpmnElement="CAT_A_catalogo_asoc">
