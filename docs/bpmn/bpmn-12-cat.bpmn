        <bpmndi:BPMNLabel>
          <dc:Bounds x="478" y="725.0" width="31.519999999999982" height="29.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CAT_F06_di" bpmnElement="CAT_F06">
        <di:waypoint x="470" y="324.0"/>
        <di:waypoint x="470" y="420.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CAT_F07_di" bpmnElement="CAT_F07">
        <di:waypoint x="1060" y="714.0"/>
        <di:waypoint x="1060" y="800.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1068" y="725.0" width="31.519999999999982" height="29.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CAT_F08_di" bpmnElement="CAT_F08">
        <di:waypoint x="1060" y="940.0"/>
