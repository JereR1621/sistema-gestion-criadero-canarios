<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="TuCriadero_BPMN" targetNamespace="urn:tucriadero:bpmn" exporter="TuCriadero" exporterVersion="1.0">
  <bpmn:process id="Process_ADM" name="Administrar cuentas y catálogo" isExecutable="false">
    <bpmn:documentation>Precondición: sesión de administrador. Un criador no accede a estas operaciones. El administrador ve datos de registro de las cuentas y catálogo, nunca los datos de los criaderos (RF005–RF006, SEG-001).
Catálogo inicial: el equipo precarga las 762 variedades de color, sus factores y composición (RF028, DAT-005). No se modela una importación de planillas por el criador.
El administrador agrega o corrige variedades, composición y factores; no se permiten códigos duplicados ni eliminar variedades asignadas. La composición no se repite para un mismo sexo (RF032, DAT-004).
Una cuenta desactivada no inicia sesión y conserva sus datos. Los cambios de catálogo aplican para todos los criadores. Toda acción administrativa se audita (RF005, RF032, SEG-003).</bpmn:documentation>
    <bpmn:laneSet id="ADM_lanes">
      <bpmn:lane id="ADM_persona" name="Administrador">
        <bpmn:flowNodeRef>ADM_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADM_operacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADM_opcion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADM_estado_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADM_estado_corregir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADM_catalogo_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADM_catalogo_corregir</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ADM_sistema" name="TuCriadero (aplicación web)">
        <bpmn:flowNodeRef>ADM_cuentas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADM_estado_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADM_estado_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADM_estado_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADM_estado_guardar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADM_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADM_catalogo_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADM_catalogo_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADM_catalogo_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADM_catalogo_guardar</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ADM_inicio" name="Administrar TuCriadero">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>ADM_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="ADM_operacion" name="Elegir administración de cuentas o catálogo">
      <bpmn:documentation>SRS-RF005, SRS-RF006, SRS-RF032</bpmn:documentation>
      <bpmn:incoming>ADM_F01</bpmn:incoming>
      <bpmn:outgoing>ADM_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ADM_opcion" name="¿Qué administra?" gatewayDirection="Diverging" default="ADM_F17">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ADM_F02</bpmn:incoming>
      <bpmn:outgoing>ADM_F03</bpmn:outgoing>
      <bpmn:outgoing>ADM_F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ADM_cuentas" name="Listar registro y estado de las cuentas">
      <bpmn:documentation>SRS-RF006</bpmn:documentation>
      <bpmn:incoming>ADM_F03</bpmn:incoming>
      <bpmn:outgoing>ADM_F09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="ADM_estado_datos" name="Seleccionar cuenta y cambio de estado">
      <bpmn:documentation>SRS-RF005, SRS-RF006</bpmn:documentation>
      <bpmn:incoming>ADM_F08</bpmn:incoming>
      <bpmn:incoming>ADM_F09</bpmn:incoming>
      <bpmn:outgoing>ADM_F04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ADM_estado_validar" name="Validar cuenta y operación administrativa">
      <bpmn:documentation>SRS-RF005, SRS-RF006</bpmn:documentation>
      <bpmn:incoming>ADM_F04</bpmn:incoming>
      <bpmn:outgoing>ADM_F05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ADM_estado_valido" name="¿Datos válidos?" gatewayDirection="Diverging" default="ADM_F06">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ADM_F05</bpmn:incoming>
      <bpmn:outgoing>ADM_F06</bpmn:outgoing>
      <bpmn:outgoing>ADM_F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ADM_estado_error" name="Mostrar los errores sin guardar cambios">
      <bpmn:documentation>SRS-RF005, SRS-RF006</bpmn:documentation>
      <bpmn:incoming>ADM_F06</bpmn:incoming>
      <bpmn:outgoing>ADM_F07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="ADM_estado_corregir" name="Corregir los datos del formulario">
      <bpmn:documentation>SRS-RF005, SRS-RF006</bpmn:documentation>
      <bpmn:incoming>ADM_F07</bpmn:incoming>
      <bpmn:outgoing>ADM_F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ADM_estado_guardar" name="Guardar estado sin borrar datos y auditar">
      <bpmn:documentation>SRS-RF005</bpmn:documentation>
      <bpmn:incoming>ADM_F10</bpmn:incoming>
      <bpmn:outgoing>ADM_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ADM_fin" name="Operación administrativa completada">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ADM_F11</bpmn:incoming>
      <bpmn:incoming>ADM_F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="ADM_catalogo_datos" name="Agregar, corregir o solicitar eliminar datos del catálogo">
      <bpmn:documentation>SRS-RF028, SRS-RF029, SRS-RF030, SRS-RF031, SRS-RF032</bpmn:documentation>
      <bpmn:incoming>ADM_F16</bpmn:incoming>
      <bpmn:incoming>ADM_F17</bpmn:incoming>
      <bpmn:outgoing>ADM_F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ADM_catalogo_validar" name="Validar códigos, composición, herencia y uso">
      <bpmn:documentation>SRS-RF028, SRS-RF029, SRS-RF030, SRS-RF031, SRS-RF032
Solo variedades de color; códigos únicos; variedad asignada no se elimina; composición única por sexo; tipo de herencia del catálogo.</bpmn:documentation>
      <bpmn:incoming>ADM_F12</bpmn:incoming>
      <bpmn:outgoing>ADM_F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ADM_catalogo_valido" name="¿Datos válidos?" gatewayDirection="Diverging" default="ADM_F14">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ADM_F13</bpmn:incoming>
      <bpmn:outgoing>ADM_F14</bpmn:outgoing>
      <bpmn:outgoing>ADM_F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ADM_catalogo_error" name="Mostrar los errores sin guardar cambios">
      <bpmn:documentation>SRS-RF028, SRS-RF029, SRS-RF030, SRS-RF031, SRS-RF032</bpmn:documentation>
      <bpmn:incoming>ADM_F14</bpmn:incoming>
      <bpmn:outgoing>ADM_F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="ADM_catalogo_corregir" name="Corregir los datos del formulario">
      <bpmn:documentation>SRS-RF028, SRS-RF029, SRS-RF030, SRS-RF031, SRS-RF032</bpmn:documentation>
      <bpmn:incoming>ADM_F15</bpmn:incoming>
      <bpmn:outgoing>ADM_F16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ADM_catalogo_guardar" name="Aplicar catálogo para todos los criadores y auditar">
      <bpmn:documentation>SRS-RF032</bpmn:documentation>
      <bpmn:incoming>ADM_F18</bpmn:incoming>
      <bpmn:outgoing>ADM_F19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="ADM_F01" sourceRef="ADM_inicio" targetRef="ADM_operacion" name=""/>
    <bpmn:sequenceFlow id="ADM_F02" sourceRef="ADM_operacion" targetRef="ADM_opcion" name=""/>
    <bpmn:sequenceFlow id="ADM_F03" sourceRef="ADM_opcion" targetRef="ADM_cuentas" name="Cuentas">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">area = cuentas</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ADM_F04" sourceRef="ADM_estado_datos" targetRef="ADM_estado_validar" name=""/>
    <bpmn:sequenceFlow id="ADM_F05" sourceRef="ADM_estado_validar" targetRef="ADM_estado_valido" name=""/>
    <bpmn:sequenceFlow id="ADM_F06" sourceRef="ADM_estado_valido" targetRef="ADM_estado_error" name="No"/>
    <bpmn:sequenceFlow id="ADM_F07" sourceRef="ADM_estado_error" targetRef="ADM_estado_corregir" name=""/>
    <bpmn:sequenceFlow id="ADM_F08" sourceRef="ADM_estado_corregir" targetRef="ADM_estado_datos" name="Reintentar"/>
    <bpmn:sequenceFlow id="ADM_F09" sourceRef="ADM_cuentas" targetRef="ADM_estado_datos" name=""/>
    <bpmn:sequenceFlow id="ADM_F10" sourceRef="ADM_estado_valido" targetRef="ADM_estado_guardar" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_validos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ADM_F11" sourceRef="ADM_estado_guardar" targetRef="ADM_fin" name=""/>
    <bpmn:sequenceFlow id="ADM_F12" sourceRef="ADM_catalogo_datos" targetRef="ADM_catalogo_validar" name=""/>
    <bpmn:sequenceFlow id="ADM_F13" sourceRef="ADM_catalogo_validar" targetRef="ADM_catalogo_valido" name=""/>
    <bpmn:sequenceFlow id="ADM_F14" sourceRef="ADM_catalogo_valido" targetRef="ADM_catalogo_error" name="No"/>
    <bpmn:sequenceFlow id="ADM_F15" sourceRef="ADM_catalogo_error" targetRef="ADM_catalogo_corregir" name=""/>
    <bpmn:sequenceFlow id="ADM_F16" sourceRef="ADM_catalogo_corregir" targetRef="ADM_catalogo_datos" name="Reintentar"/>
    <bpmn:sequenceFlow id="ADM_F17" sourceRef="ADM_opcion" targetRef="ADM_catalogo_datos" name="Catálogo"/>
    <bpmn:sequenceFlow id="ADM_F18" sourceRef="ADM_catalogo_valido" targetRef="ADM_catalogo_guardar" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_validos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ADM_F19" sourceRef="ADM_catalogo_guardar" targetRef="ADM_fin" name=""/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_ADM">
    <bpmn:participant id="Participant_ADM" name="TuCriadero — Administrar cuentas y catálogo" processRef="Process_ADM"/>
  </bpmn:collaboration>
