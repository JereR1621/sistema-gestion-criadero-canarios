{
    "name": "tucriadero/aplicacion",
    "description": "Base técnica de TuCriadero",
    "type": "project",
    "require": {
        "php": "^8.2",
        "dompdf/dompdf": "^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "TuCriadero\\": "backend/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TuCriadero\\Tests\\": "backend/tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    },
    "config": {
        "sort-packages": true
    }
}
