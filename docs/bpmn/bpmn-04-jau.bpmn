<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="TuCriadero_BPMN" targetNamespace="urn:tucriadero:bpmn" exporter="TuCriadero" exporterVersion="1.0">
  <bpmn:process id="Process_JAU" name="Gestionar jaulas y ubicaciones" isExecutable="false">
    <bpmn:documentation>Precondición: sesión de criador válida. Número de jaula único por criadero; canario y jaula pertenecen al criadero de la sesión (RF003, DAT-004).
Jaula grande: ubicación sin número de jaula. Un traslado cierra la ubicación anterior y abre la nueva; como máximo una ubicación abierta por canario (DAT-004).
El historial reúne ocupantes y cruces ordenados por fecha. Consultarlo no altera las ubicaciones (RF017).</bpmn:documentation>
    <bpmn:laneSet id="JAU_lanes">
      <bpmn:lane id="JAU_persona" name="Criador">
        <bpmn:flowNodeRef>JAU_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_operacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_opcion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_nueva_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_nueva_corregir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_ubicacion_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_ubicacion_corregir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_seleccionar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="JAU_sistema" name="TuCriadero (aplicación web)">
        <bpmn:flowNodeRef>JAU_nueva_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_nueva_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_nueva_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_alta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_ubicacion_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_ubicacion_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_ubicacion_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_mover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_historial</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="JAU_inicio" name="Gestionar jaulas">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>JAU_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="JAU_operacion" name="Elegir alta, asignación, traslado o historial">
      <bpmn:documentation>SRS-RF014, SRS-RF015, SRS-RF016, SRS-RF017</bpmn:documentation>
      <bpmn:incoming>JAU_F01</bpmn:incoming>
      <bpmn:outgoing>JAU_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="JAU_opcion" name="¿Qué operación?" gatewayDirection="Diverging" default="JAU_F19">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>JAU_F02</bpmn:incoming>
      <bpmn:outgoing>JAU_F08</bpmn:outgoing>
      <bpmn:outgoing>JAU_F16</bpmn:outgoing>
      <bpmn:outgoing>JAU_F19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="JAU_nueva_datos" name="Ingresar el número de la nueva jaula">
      <bpmn:documentation>SRS-RF014</bpmn:documentation>
      <bpmn:incoming>JAU_F07</bpmn:incoming>
      <bpmn:incoming>JAU_F08</bpmn:incoming>
      <bpmn:outgoing>JAU_F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="JAU_nueva_validar" name="Validar número único en el criadero">
      <bpmn:documentation>SRS-RF014</bpmn:documentation>
      <bpmn:incoming>JAU_F03</bpmn:incoming>
      <bpmn:outgoing>JAU_F04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="JAU_nueva_valido" name="¿Datos válidos?" gatewayDirection="Diverging" default="JAU_F05">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>JAU_F04</bpmn:incoming>
      <bpmn:outgoing>JAU_F05</bpmn:outgoing>
      <bpmn:outgoing>JAU_F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="JAU_nueva_error" name="Mostrar los errores sin guardar cambios">
      <bpmn:documentation>SRS-RF014</bpmn:documentation>
      <bpmn:incoming>JAU_F05</bpmn:incoming>
      <bpmn:outgoing>JAU_F06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="JAU_nueva_corregir" name="Corregir los datos del formulario">
      <bpmn:documentation>SRS-RF014</bpmn:documentation>
      <bpmn:incoming>JAU_F06</bpmn:incoming>
      <bpmn:outgoing>JAU_F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="JAU_alta" name="Registrar la jaula numerada">
      <bpmn:documentation>SRS-RF014</bpmn:documentation>
      <bpmn:incoming>JAU_F09</bpmn:incoming>
      <bpmn:outgoing>JAU_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="JAU_fin" name="Operación de jaulas completada">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>JAU_F10</bpmn:incoming>
      <bpmn:incoming>JAU_F18</bpmn:incoming>
      <bpmn:incoming>JAU_F21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="JAU_ubicacion_datos" name="Elegir canario, destino y fecha del movimiento">
      <bpmn:documentation>SRS-RF015, SRS-RF016</bpmn:documentation>
      <bpmn:incoming>JAU_F15</bpmn:incoming>
      <bpmn:incoming>JAU_F16</bpmn:incoming>
      <bpmn:outgoing>JAU_F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="JAU_ubicacion_validar" name="Validar canario, destino y pertenencia al criadero">
      <bpmn:documentation>SRS-RF015, SRS-RF016</bpmn:documentation>
      <bpmn:incoming>JAU_F11</bpmn:incoming>
      <bpmn:outgoing>JAU_F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="JAU_ubicacion_valido" name="¿Datos válidos?" gatewayDirection="Diverging" default="JAU_F13">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>JAU_F12</bpmn:incoming>
      <bpmn:outgoing>JAU_F13</bpmn:outgoing>
      <bpmn:outgoing>JAU_F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="JAU_ubicacion_error" name="Mostrar los errores sin guardar cambios">
      <bpmn:documentation>SRS-RF015, SRS-RF016</bpmn:documentation>
      <bpmn:incoming>JAU_F13</bpmn:incoming>
      <bpmn:outgoing>JAU_F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="JAU_ubicacion_corregir" name="Corregir los datos del formulario">
      <bpmn:documentation>SRS-RF015, SRS-RF016</bpmn:documentation>
      <bpmn:incoming>JAU_F14</bpmn:incoming>
      <bpmn:outgoing>JAU_F15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="JAU_mover" name="Cerrar ubicación anterior y abrir la nueva">
      <bpmn:documentation>SRS-RF015, SRS-RF016</bpmn:documentation>
      <bpmn:incoming>JAU_F17</bpmn:incoming>
      <bpmn:outgoing>JAU_F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="JAU_seleccionar" name="Elegir la jaula cuyo historial consulta">
      <bpmn:documentation>SRS-RF017</bpmn:documentation>
      <bpmn:incoming>JAU_F19</bpmn:incoming>
      <bpmn:outgoing>JAU_F20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="JAU_historial" name="Mostrar ocupantes y cruces ordenados por fecha">
      <bpmn:documentation>SRS-RF017</bpmn:documentation>
      <bpmn:incoming>JAU_F20</bpmn:incoming>
      <bpmn:outgoing>JAU_F21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="JAU_F01" sourceRef="JAU_inicio" targetRef="JAU_operacion" name=""/>
    <bpmn:sequenceFlow id="JAU_F02" sourceRef="JAU_operacion" targetRef="JAU_opcion" name=""/>
    <bpmn:sequenceFlow id="JAU_F03" sourceRef="JAU_nueva_datos" targetRef="JAU_nueva_validar" name=""/>
    <bpmn:sequenceFlow id="JAU_F04" sourceRef="JAU_nueva_validar" targetRef="JAU_nueva_valido" name=""/>
    <bpmn:sequenceFlow id="JAU_F05" sourceRef="JAU_nueva_valido" targetRef="JAU_nueva_error" name="No"/>
    <bpmn:sequenceFlow id="JAU_F06" sourceRef="JAU_nueva_error" targetRef="JAU_nueva_corregir" name=""/>
    <bpmn:sequenceFlow id="JAU_F07" sourceRef="JAU_nueva_corregir" targetRef="JAU_nueva_datos" name="Reintentar"/>
    <bpmn:sequenceFlow id="JAU_F08" sourceRef="JAU_opcion" targetRef="JAU_nueva_datos" name="Nueva jaula">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">operacion = alta</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="JAU_F09" sourceRef="JAU_nueva_valido" targetRef="JAU_alta" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_validos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="JAU_F10" sourceRef="JAU_alta" targetRef="JAU_fin" name=""/>
    <bpmn:sequenceFlow id="JAU_F11" sourceRef="JAU_ubicacion_datos" targetRef="JAU_ubicacion_validar" name=""/>
    <bpmn:sequenceFlow id="JAU_F12" sourceRef="JAU_ubicacion_validar" targetRef="JAU_ubicacion_valido" name=""/>
    <bpmn:sequenceFlow id="JAU_F13" sourceRef="JAU_ubicacion_valido" targetRef="JAU_ubicacion_error" name="No"/>
    <bpmn:sequenceFlow id="JAU_F14" sourceRef="JAU_ubicacion_error" targetRef="JAU_ubicacion_corregir" name=""/>
    <bpmn:sequenceFlow id="JAU_F15" sourceRef="JAU_ubicacion_corregir" targetRef="JAU_ubicacion_datos" name="Reintentar"/>
    <bpmn:sequenceFlow id="JAU_F16" sourceRef="JAU_opcion" targetRef="JAU_ubicacion_datos" name="Asignar o trasladar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">operacion = movimiento</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="JAU_F17" sourceRef="JAU_ubicacion_valido" targetRef="JAU_mover" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_validos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="JAU_F18" sourceRef="JAU_mover" targetRef="JAU_fin" name=""/>
    <bpmn:sequenceFlow id="JAU_F19" sourceRef="JAU_opcion" targetRef="JAU_seleccionar" name="Consultar historial"/>
    <bpmn:sequenceFlow id="JAU_F20" sourceRef="JAU_seleccionar" targetRef="JAU_historial" name=""/>
    <bpmn:sequenceFlow id="JAU_F21" sourceRef="JAU_historial" targetRef="JAU_fin" name=""/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_JAU">
    <bpmn:participant id="Participant_JAU" name="TuCriadero — Gestionar jaulas y ubicaciones" processRef="Process_JAU"/>
  </bpmn:collaboration>
