          <dc:Bounds x="272.15999999999997" y="615" width="155.84000000000003" height="55"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CAT_catalogo_cancelado_di" bpmnElement="CAT_catalogo_cancelado">
        <dc:Bounds x="446.0" y="846.0" width="48" height="48"/>
