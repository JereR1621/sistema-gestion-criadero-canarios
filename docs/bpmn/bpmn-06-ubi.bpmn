          <dc:Bounds x="1102.0" y="640" width="192.79999999999995" height="30"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UBI_mover_corrige_di" bpmnElement="UBI_mover_corrige" isMarkerVisible="true">
