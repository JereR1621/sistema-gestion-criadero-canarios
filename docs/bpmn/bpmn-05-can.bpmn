      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CAN_F09_di" bpmnElement="CAN_F09">
        <di:waypoint x="1120" y="1158.0"/>
        <di:waypoint x="1120" y="1202.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CAN_F10_di" bpmnElement="CAN_F10">
        <di:waypoint x="1120" y="1318.0"/>
        <di:waypoint x="1120" y="1362.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CAN_F11_di" bpmnElement="CAN_F11">
        <di:waypoint x="1120" y="1478.0"/>
        <di:waypoint x="1120" y="1556.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
