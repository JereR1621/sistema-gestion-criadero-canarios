<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="TuCriadero_BPMN" targetNamespace="urn:tucriadero:bpmn" exporter="TuCriadero" exporterVersion="2.0">
  <bpmn:error id="Error_no_disponible" name="Sin conexión, mantenimiento o sesión expirada" errorCode="NO_DISPONIBLE"/>
  <bpmn:process id="Process_ACC" name="Acceder a TuCriadero y completar el perfil" isExecutable="false">
    <bpmn:documentation>El autorregistro crea solo cuentas de criador; la cuenta de administrador la crea el equipo (RF001, SEG-001).
La sesión queda limitada al criadero del usuario (RF002–RF003), expira tras 7 días de inactividad y puede cerrarse en cualquier momento (SEG-004). Socio y club se proponen por defecto al anillar (RF004).</bpmn:documentation>
    <bpmn:laneSet id="ACC_lanes">
      <bpmn:lane id="ACC_persona" name="Criador">
        <bpmn:flowNodeRef>ACC_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_cuenta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_registro_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_registro_corrige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_registro_cancelado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_ingreso_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_ingreso_reintenta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_ingreso_cancelado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_perfil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_perfil_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_perfil_corrige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_perfil_cancelado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ACC_sistema" name="TuCriadero (aplicación web)">
        <bpmn:flowNodeRef>ACC_registro_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_registro_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_crear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_ingreso_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_ingreso_resultado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_rechazado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_sesion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_perfil_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_perfil_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_guardar_perfil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_no_disponible</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ACC_inicio" name="Acceder a TuCriadero">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>ACC_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="ACC_cuenta" name="¿Tiene cuenta?" gatewayDirection="Diverging" default="ACC_F07">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F01</bpmn:incoming>
      <bpmn:outgoing>ACC_F07</bpmn:outgoing>
      <bpmn:outgoing>ACC_F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ACC_registro_datos" name="Ingresar nombre, correo y contraseña">
      <bpmn:documentation>SRS-RF001</bpmn:documentation>
      <bpmn:incoming>ACC_F05</bpmn:incoming>
      <bpmn:incoming>ACC_F07</bpmn:incoming>
      <bpmn:outgoing>ACC_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ACC_registro_validar" name="Validar los datos del registro">
      <bpmn:documentation>SRS-RF001</bpmn:documentation>
      <bpmn:incoming>ACC_F02</bpmn:incoming>
      <bpmn:outgoing>ACC_F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ACC_registro_valido" name="¿Datos válidos?" gatewayDirection="Diverging" default="ACC_F04">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F03</bpmn:incoming>
      <bpmn:outgoing>ACC_F04</bpmn:outgoing>
      <bpmn:outgoing>ACC_F08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ACC_registro_corrige" name="¿Corrige los datos?" gatewayDirection="Diverging" default="ACC_F06">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F04</bpmn:incoming>
      <bpmn:outgoing>ACC_F05</bpmn:outgoing>
      <bpmn:outgoing>ACC_F06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ACC_registro_cancelado" name="Registro cancelado; sin cuenta nueva">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ACC_crear" name="Crear la cuenta de criador y su criadero vacío">
      <bpmn:documentation>SRS-RF001</bpmn:documentation>
      <bpmn:incoming>ACC_F08</bpmn:incoming>
      <bpmn:outgoing>ACC_F09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="ACC_ingreso_datos" name="Ingresar el correo y la contraseña">
      <bpmn:documentation>SRS-RF002, SRS-RF003</bpmn:documentation>
      <bpmn:incoming>ACC_F09</bpmn:incoming>
      <bpmn:incoming>ACC_F10</bpmn:incoming>
      <bpmn:incoming>ACC_F14</bpmn:incoming>
      <bpmn:outgoing>ACC_F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ACC_ingreso_validar" name="Validar las credenciales y el estado de la cuenta">
      <bpmn:documentation>SRS-RF002, SRS-RF003, SRS-RF005</bpmn:documentation>
      <bpmn:incoming>ACC_F11</bpmn:incoming>
      <bpmn:outgoing>ACC_F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ACC_ingreso_resultado" name="¿Resultado?" gatewayDirection="Diverging" default="ACC_F13">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F12</bpmn:incoming>
      <bpmn:outgoing>ACC_F13</bpmn:outgoing>
      <bpmn:outgoing>ACC_F16</bpmn:outgoing>
      <bpmn:outgoing>ACC_F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ACC_ingreso_reintenta" name="¿Intenta de nuevo?" gatewayDirection="Diverging" default="ACC_F15">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F13</bpmn:incoming>
      <bpmn:outgoing>ACC_F14</bpmn:outgoing>
      <bpmn:outgoing>ACC_F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ACC_ingreso_cancelado" name="Ingreso cancelado">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ACC_rechazado" name="Acceso rechazado: cuenta desactivada">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ACC_sesion" name="Abrir la sesión con el rol y el criadero autorizados">
      <bpmn:documentation>SRS-RF002, SRS-RF003</bpmn:documentation>
      <bpmn:incoming>ACC_F17</bpmn:incoming>
      <bpmn:outgoing>ACC_F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ACC_perfil" name="¿Actualiza el socio y el club?" gatewayDirection="Diverging" default="ACC_F27">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F18</bpmn:incoming>
      <bpmn:outgoing>ACC_F24</bpmn:outgoing>
      <bpmn:outgoing>ACC_F27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ACC_perfil_datos" name="Ingresar el número de socio y el club">
      <bpmn:documentation>SRS-RF004</bpmn:documentation>
      <bpmn:incoming>ACC_F22</bpmn:incoming>
      <bpmn:incoming>ACC_F24</bpmn:incoming>
      <bpmn:outgoing>ACC_F19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ACC_perfil_validar" name="Validar los datos del perfil">
      <bpmn:documentation>SRS-RF004</bpmn:documentation>
      <bpmn:incoming>ACC_F19</bpmn:incoming>
      <bpmn:outgoing>ACC_F20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ACC_perfil_valido" name="¿Datos válidos?" gatewayDirection="Diverging" default="ACC_F21">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F20</bpmn:incoming>
      <bpmn:outgoing>ACC_F21</bpmn:outgoing>
      <bpmn:outgoing>ACC_F25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ACC_perfil_corrige" name="¿Corrige los datos?" gatewayDirection="Diverging" default="ACC_F23">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F21</bpmn:incoming>
      <bpmn:outgoing>ACC_F22</bpmn:outgoing>
      <bpmn:outgoing>ACC_F23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ACC_perfil_cancelado" name="Perfil sin cambios; acceso disponible">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ACC_guardar_perfil" name="Guardar socio y club como valores por defecto">
      <bpmn:documentation>SRS-RF004</bpmn:documentation>
      <bpmn:incoming>ACC_F25</bpmn:incoming>
      <bpmn:outgoing>ACC_F26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ACC_fin" name="Acceso disponible con sesión autorizada">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F26</bpmn:incoming>
      <bpmn:incoming>ACC_F27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="ACC_F01" sourceRef="ACC_inicio" targetRef="ACC_cuenta" name=""/>
    <bpmn:sequenceFlow id="ACC_F02" sourceRef="ACC_registro_datos" targetRef="ACC_registro_validar" name=""/>
    <bpmn:sequenceFlow id="ACC_F03" sourceRef="ACC_registro_validar" targetRef="ACC_registro_valido" name=""/>
    <bpmn:sequenceFlow id="ACC_F04" sourceRef="ACC_registro_valido" targetRef="ACC_registro_corrige" name="No"/>
    <bpmn:sequenceFlow id="ACC_F05" sourceRef="ACC_registro_corrige" targetRef="ACC_registro_datos" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">corrige</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ACC_F06" sourceRef="ACC_registro_corrige" targetRef="ACC_registro_cancelado" name="No"/>
    <bpmn:sequenceFlow id="ACC_F07" sourceRef="ACC_cuenta" targetRef="ACC_registro_datos" name="No"/>
    <bpmn:sequenceFlow id="ACC_F08" sourceRef="ACC_registro_valido" targetRef="ACC_crear" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_validos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ACC_F09" sourceRef="ACC_crear" targetRef="ACC_ingreso_datos" name=""/>
    <bpmn:sequenceFlow id="ACC_F10" sourceRef="ACC_cuenta" targetRef="ACC_ingreso_datos" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">tiene_cuenta</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ACC_F11" sourceRef="ACC_ingreso_datos" targetRef="ACC_ingreso_validar" name=""/>
    <bpmn:sequenceFlow id="ACC_F12" sourceRef="ACC_ingreso_validar" targetRef="ACC_ingreso_resultado" name=""/>
    <bpmn:sequenceFlow id="ACC_F13" sourceRef="ACC_ingreso_resultado" targetRef="ACC_ingreso_reintenta" name="Credenciales incorrectas"/>
    <bpmn:sequenceFlow id="ACC_F14" sourceRef="ACC_ingreso_reintenta" targetRef="ACC_ingreso_datos" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reintenta</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ACC_F15" sourceRef="ACC_ingreso_reintenta" targetRef="ACC_ingreso_cancelado" name="No"/>
    <bpmn:sequenceFlow id="ACC_F16" sourceRef="ACC_ingreso_resultado" targetRef="ACC_rechazado" name="Desactivada">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">cuenta = desactivada</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ACC_F17" sourceRef="ACC_ingreso_resultado" targetRef="ACC_sesion" name="Válidas">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">credenciales_validas</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ACC_F18" sourceRef="ACC_sesion" targetRef="ACC_perfil" name=""/>
    <bpmn:sequenceFlow id="ACC_F19" sourceRef="ACC_perfil_datos" targetRef="ACC_perfil_validar" name=""/>
    <bpmn:sequenceFlow id="ACC_F20" sourceRef="ACC_perfil_validar" targetRef="ACC_perfil_valido" name=""/>
    <bpmn:sequenceFlow id="ACC_F21" sourceRef="ACC_perfil_valido" targetRef="ACC_perfil_corrige" name="No"/>
    <bpmn:sequenceFlow id="ACC_F22" sourceRef="ACC_perfil_corrige" targetRef="ACC_perfil_datos" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">corrige</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ACC_F23" sourceRef="ACC_perfil_corrige" targetRef="ACC_perfil_cancelado" name="No"/>
    <bpmn:sequenceFlow id="ACC_F24" sourceRef="ACC_perfil" targetRef="ACC_perfil_datos" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">actualizar_perfil</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ACC_F25" sourceRef="ACC_perfil_valido" targetRef="ACC_guardar_perfil" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_validos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ACC_F26" sourceRef="ACC_guardar_perfil" targetRef="ACC_fin" name=""/>
    <bpmn:sequenceFlow id="ACC_F27" sourceRef="ACC_perfil" targetRef="ACC_fin" name="No"/>
    <bpmn:subProcess id="ACC_no_disponible" name="Sin conexión o mantenimiento" triggeredByEvent="true">
      <bpmn:startEvent id="ACC_no_disponible_inicio" name="Sin conexión o mantenimiento" isInterrupting="true">
        <bpmn:outgoing>ACC_no_disponible_F1</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ACC_no_disponible_err" errorRef="Error_no_disponible"/>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ACC_no_disponible_informar" name="Informar el motivo y no guardar cambios">
        <bpmn:documentation>SRS §2.5 (modo degradado y mantenimiento) y SEG-004 (sesión).</bpmn:documentation>
        <bpmn:incoming>ACC_no_disponible_F1</bpmn:incoming>
        <bpmn:outgoing>ACC_no_disponible_F2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="ACC_no_disponible_fin" name="Operación no realizada; sin cambios">
        <bpmn:incoming>ACC_no_disponible_F2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="ACC_no_disponible_F1" sourceRef="ACC_no_disponible_inicio" targetRef="ACC_no_disponible_informar"/>
      <bpmn:sequenceFlow id="ACC_no_disponible_F2" sourceRef="ACC_no_disponible_informar" targetRef="ACC_no_disponible_fin"/>
    </bpmn:subProcess>
    <bpmn:textAnnotation id="ACC_A_registro">
      <bpmn:text>Errores que se informan sin guardar:
• Contraseña de menos de 8 caracteres (SEG-001).
• Correo ya registrado (RF002).
• Falta el nombre, el correo o la contraseña (RF001).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="ACC_A_registro_asoc" sourceRef="ACC_registro_valido" targetRef="ACC_A_registro" associationDirection="None"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_ACC">
    <bpmn:participant id="Participant_ACC" name="TuCriadero — Acceder a TuCriadero y completar el perfil" processRef="Process_ACC"/>
  </bpmn:collaboration>
