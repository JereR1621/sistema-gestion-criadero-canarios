<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="TuCriadero_BPMN" targetNamespace="urn:tucriadero:bpmn" exporter="TuCriadero" exporterVersion="1.0">
  <bpmn:process id="Process_PIC" name="Registrar pichones de un cruce" isExecutable="false">
    <bpmn:documentation>Precondición: sesión de criador válida. El cruce y sus progenitores pertenecen al criadero de la sesión (RF003, DAT-004).
El anillado físico a los 10–12 días es contexto de crianza; el sistema registra los datos. No se crea un temporizador automático ni una función de posturas de huevos.
Sexo y variedad pueden quedar sin determinar; fecha de nacimiento opcional. Padres y cruce se asignan desde el cruce seleccionado. Portadores manuales se conservan; solo se deduce lo comprobable (RF007, RF021, RF034).
Repetir este proceso cuando haya más pichones. Registrar pichones no termina el cruce; su cierre se modela por separado (RF022).</bpmn:documentation>
    <bpmn:laneSet id="PIC_lanes">
      <bpmn:lane id="PIC_persona" name="Criador">
        <bpmn:flowNodeRef>PIC_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_elegir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_anillos_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_anillos_corregir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_seguir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_mas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PIC_sistema" name="TuCriadero (aplicación web)">
        <bpmn:flowNodeRef>PIC_cruce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_anillos_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_anillos_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_anillos_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_fichas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_factores</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_mostrar</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PIC_inicio" name="Registrar pichones">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>PIC_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="PIC_elegir" name="Elegir un cruce y abrir su ficha de cría">
      <bpmn:documentation>SRS-RF027</bpmn:documentation>
      <bpmn:incoming>PIC_F01</bpmn:incoming>
      <bpmn:outgoing>PIC_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PIC_cruce" name="Obtener cruce, progenitores y datos por defecto">
      <bpmn:documentation>SRS-RF004, SRS-RF027</bpmn:documentation>
      <bpmn:incoming>PIC_F02</bpmn:incoming>
      <bpmn:outgoing>PIC_F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PIC_anillos_datos" name="Ingresar anillos y fechas de los pichones">
      <bpmn:documentation>SRS-RF007, SRS-RF008, SRS-RF012, SRS-RF021</bpmn:documentation>
      <bpmn:incoming>PIC_F07</bpmn:incoming>
      <bpmn:incoming>PIC_F08</bpmn:incoming>
      <bpmn:incoming>PIC_F14</bpmn:incoming>
      <bpmn:outgoing>PIC_F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PIC_anillos_validar" name="Validar anillos, variedad, sexo y fechas">
      <bpmn:documentation>SRS-RF007, SRS-RF008, SRS-RF012, SRS-RF021
Anillo obligatorio y no duplicado en el criadero ni en el envío; fecha de anillado; nacimiento opcional; variedad compatible con sexo cuando se determine. DAT-004.</bpmn:documentation>
      <bpmn:incoming>PIC_F03</bpmn:incoming>
      <bpmn:outgoing>PIC_F04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="PIC_anillos_valido" name="¿Datos válidos?" gatewayDirection="Diverging" default="PIC_F05">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>PIC_F04</bpmn:incoming>
      <bpmn:outgoing>PIC_F05</bpmn:outgoing>
      <bpmn:outgoing>PIC_F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="PIC_anillos_error" name="Mostrar los errores sin guardar cambios">
      <bpmn:documentation>SRS-RF007, SRS-RF008, SRS-RF012, SRS-RF021</bpmn:documentation>
      <bpmn:incoming>PIC_F05</bpmn:incoming>
      <bpmn:outgoing>PIC_F06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PIC_anillos_corregir" name="Corregir los datos del formulario">
      <bpmn:documentation>SRS-RF007, SRS-RF008, SRS-RF012, SRS-RF021</bpmn:documentation>
      <bpmn:incoming>PIC_F06</bpmn:incoming>
      <bpmn:outgoing>PIC_F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PIC_fichas" name="Crear fichas con padre, madre y cruce de origen">
      <bpmn:documentation>SRS-RF021</bpmn:documentation>
      <bpmn:incoming>PIC_F09</bpmn:incoming>
      <bpmn:outgoing>PIC_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PIC_factores" name="Obtener manifestados y deducir portadores ciertos">
      <bpmn:documentation>SRS-RF033, SRS-RF034</bpmn:documentation>
      <bpmn:incoming>PIC_F10</bpmn:incoming>
      <bpmn:outgoing>PIC_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PIC_mostrar" name="Actualizar ficha de cría y registrar auditoría">
      <bpmn:documentation>SRS-RF021, SRS-RF027</bpmn:documentation>
      <bpmn:incoming>PIC_F11</bpmn:incoming>
      <bpmn:outgoing>PIC_F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PIC_seguir" name="Revisar fichas y elegir si registra más pichones">
      <bpmn:documentation>SRS-RF021, SRS-RF027</bpmn:documentation>
      <bpmn:incoming>PIC_F12</bpmn:incoming>
      <bpmn:outgoing>PIC_F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PIC_mas" name="¿Más pichones?" gatewayDirection="Diverging" default="PIC_F15">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>PIC_F13</bpmn:incoming>
      <bpmn:outgoing>PIC_F14</bpmn:outgoing>
      <bpmn:outgoing>PIC_F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="PIC_fin" name="Pichones registrados; cruce conservado">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>PIC_F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="PIC_F01" sourceRef="PIC_inicio" targetRef="PIC_elegir" name=""/>
    <bpmn:sequenceFlow id="PIC_F02" sourceRef="PIC_elegir" targetRef="PIC_cruce" name=""/>
    <bpmn:sequenceFlow id="PIC_F03" sourceRef="PIC_anillos_datos" targetRef="PIC_anillos_validar" name=""/>
    <bpmn:sequenceFlow id="PIC_F04" sourceRef="PIC_anillos_validar" targetRef="PIC_anillos_valido" name=""/>
    <bpmn:sequenceFlow id="PIC_F05" sourceRef="PIC_anillos_valido" targetRef="PIC_anillos_error" name="No"/>
    <bpmn:sequenceFlow id="PIC_F06" sourceRef="PIC_anillos_error" targetRef="PIC_anillos_corregir" name=""/>
    <bpmn:sequenceFlow id="PIC_F07" sourceRef="PIC_anillos_corregir" targetRef="PIC_anillos_datos" name="Reintentar"/>
    <bpmn:sequenceFlow id="PIC_F08" sourceRef="PIC_cruce" targetRef="PIC_anillos_datos" name=""/>
    <bpmn:sequenceFlow id="PIC_F09" sourceRef="PIC_anillos_valido" targetRef="PIC_fichas" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_validos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PIC_F10" sourceRef="PIC_fichas" targetRef="PIC_factores" name=""/>
    <bpmn:sequenceFlow id="PIC_F11" sourceRef="PIC_factores" targetRef="PIC_mostrar" name=""/>
    <bpmn:sequenceFlow id="PIC_F12" sourceRef="PIC_mostrar" targetRef="PIC_seguir" name=""/>
    <bpmn:sequenceFlow id="PIC_F13" sourceRef="PIC_seguir" targetRef="PIC_mas" name=""/>
    <bpmn:sequenceFlow id="PIC_F14" sourceRef="PIC_mas" targetRef="PIC_anillos_datos" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">mas_pichones</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PIC_F15" sourceRef="PIC_mas" targetRef="PIC_fin" name="No"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_PIC">
    <bpmn:participant id="Participant_PIC" name="TuCriadero — Registrar pichones de un cruce" processRef="Process_PIC"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_PIC" name="Registrar pichones de un cruce">
    <bpmndi:BPMNPlane id="Plane_PIC" bpmnElement="Collaboration_PIC">
