<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="TuCriadero_BPMN" targetNamespace="urn:tucriadero:bpmn" exporter="TuCriadero" exporterVersion="1.0">
  <bpmn:process id="Process_CRU" name="Planificar y registrar un cruce" isExecutable="false">
    <bpmn:documentation>Precondición: sesión de criador válida. Solo se consultan y modifican registros de su propio criadero (RF002–RF003).
Los cruces de una hembra con varios machos y de un macho con varias hembras se registran repitiendo este proceso para cada pareja, sin sustituir los cruces anteriores (RF019–RF020).
El catálogo está precargado. Se usan su composición y tipos de herencia; los resultados se separan por sexo. SUP-004: independencia de factores y una dosis dominante; avisar cuando el resultado sea aproximado.
La vista previa no guarda un cruce. Si faltan reglas, se informa lo no calculable sin inventar porcentajes; los cálculos disponibles se muestran con esa advertencia (RF039).</bpmn:documentation>
    <bpmn:laneSet id="CRU_lanes">
      <bpmn:lane id="CRU_persona" name="Criador">
        <bpmn:flowNodeRef>CRU_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_propuesta_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_propuesta_corregir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_confirma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_cancelado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CRU_sistema" name="TuCriadero (aplicación web)">
        <bpmn:flowNodeRef>CRU_propuesta_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_propuesta_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_propuesta_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_catalogo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_calcular</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_reglas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_aviso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_resultado_listo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_mostrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_revalidar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_confirmacion_valida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_cambio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_guardar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CRU_inicio" name="Planificar un cruce">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>CRU_F06</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="CRU_propuesta_datos" name="Elegir macho, hembra, jaula, temporada y fecha">
      <bpmn:documentation>SRS-RF018, SRS-RF019, SRS-RF020</bpmn:documentation>
      <bpmn:incoming>CRU_F05</bpmn:incoming>
      <bpmn:incoming>CRU_F06</bpmn:incoming>
      <bpmn:incoming>CRU_F16</bpmn:incoming>
      <bpmn:incoming>CRU_F21</bpmn:incoming>
      <bpmn:outgoing>CRU_F01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CRU_propuesta_validar" name="Validar progenitores, sexo, jaula y criadero">
      <bpmn:documentation>SRS-RF018, SRS-RF019, SRS-RF020
Macho y hembra con sexo conocido y del criadero; jaula del mismo criadero; datos obligatorios completos. DAT-004.</bpmn:documentation>
      <bpmn:incoming>CRU_F01</bpmn:incoming>
      <bpmn:outgoing>CRU_F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CRU_propuesta_valido" name="¿Datos válidos?" gatewayDirection="Diverging" default="CRU_F03">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CRU_F02</bpmn:incoming>
      <bpmn:outgoing>CRU_F03</bpmn:outgoing>
      <bpmn:outgoing>CRU_F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CRU_propuesta_error" name="Mostrar los errores sin guardar cambios">
      <bpmn:documentation>SRS-RF018, SRS-RF019, SRS-RF020</bpmn:documentation>
      <bpmn:incoming>CRU_F03</bpmn:incoming>
      <bpmn:outgoing>CRU_F04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="CRU_propuesta_corregir" name="Corregir los datos del formulario">
      <bpmn:documentation>SRS-RF018, SRS-RF019, SRS-RF020</bpmn:documentation>
      <bpmn:incoming>CRU_F04</bpmn:incoming>
      <bpmn:outgoing>CRU_F05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CRU_catalogo" name="Obtener factores manifestados, portados y herencia">
      <bpmn:documentation>SRS-RF028, SRS-RF029, SRS-RF030, SRS-RF031, SRS-RF033, SRS-RF034
Armar genotipos con la variedad y los portadores de ambos progenitores. Un dato sin determinar no equivale a un factor normal conocido; informar lo que no puede calcularse.</bpmn:documentation>
      <bpmn:incoming>CRU_F07</bpmn:incoming>
      <bpmn:outgoing>CRU_F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CRU_calcular" name="Calcular proporciones con las reglas disponibles">
      <bpmn:documentation>SRS-RF035, SRS-RF036, SRS-RF037, SRS-RF038, SRS-RF039
Reglas ligadas al sexo, recesivas y dominantes. Combinar según SUP-004; resolver variedad o lista de factores.</bpmn:documentation>
      <bpmn:incoming>CRU_F08</bpmn:incoming>
      <bpmn:outgoing>CRU_F09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CRU_reglas" name="¿Faltan reglas?" gatewayDirection="Diverging" default="CRU_F11">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CRU_F09</bpmn:incoming>
      <bpmn:outgoing>CRU_F10</bpmn:outgoing>
      <bpmn:outgoing>CRU_F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CRU_aviso" name="Informar factores no calculables y limitaciones">
      <bpmn:documentation>SRS-RF039</bpmn:documentation>
      <bpmn:incoming>CRU_F10</bpmn:incoming>
      <bpmn:outgoing>CRU_F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CRU_resultado_listo" name="" gatewayDirection="Converging">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CRU_F11</bpmn:incoming>
      <bpmn:incoming>CRU_F12</bpmn:incoming>
      <bpmn:outgoing>CRU_F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CRU_mostrar" name="Mostrar porcentajes por sexo, factores y avisos">
      <bpmn:documentation>SRS-RF035, SRS-RF039</bpmn:documentation>
      <bpmn:incoming>CRU_F13</bpmn:incoming>
      <bpmn:outgoing>CRU_F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="CRU_revisar" name="Revisar el posible resultado y decidir">
      <bpmn:documentation>SRS-RF035</bpmn:documentation>
      <bpmn:incoming>CRU_F14</bpmn:incoming>
      <bpmn:outgoing>CRU_F15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CRU_confirma" name="¿Qué decide?" gatewayDirection="Diverging" default="CRU_F17">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CRU_F15</bpmn:incoming>
      <bpmn:outgoing>CRU_F16</bpmn:outgoing>
      <bpmn:outgoing>CRU_F17</bpmn:outgoing>
      <bpmn:outgoing>CRU_F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="CRU_cancelado" name="Propuesta cancelada; sin cruce guardado">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CRU_F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="CRU_revalidar" name="Revalidar los datos al confirmar">
      <bpmn:documentation>SRS-RF018</bpmn:documentation>
      <bpmn:incoming>CRU_F18</bpmn:incoming>
      <bpmn:outgoing>CRU_F19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CRU_confirmacion_valida" name="¿Datos vigentes?" gatewayDirection="Diverging" default="CRU_F20">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CRU_F19</bpmn:incoming>
      <bpmn:outgoing>CRU_F20</bpmn:outgoing>
      <bpmn:outgoing>CRU_F22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CRU_cambio" name="Informar cambios o errores y no guardar">
      <bpmn:documentation>SRS-RF018</bpmn:documentation>
      <bpmn:incoming>CRU_F20</bpmn:incoming>
      <bpmn:outgoing>CRU_F21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CRU_guardar" name="Registrar cruce con fecha de inicio y auditar">
      <bpmn:documentation>SRS-RF018, SRS-RF019, SRS-RF020</bpmn:documentation>
      <bpmn:incoming>CRU_F22</bpmn:incoming>
      <bpmn:outgoing>CRU_F23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CRU_fin" name="Cruce registrado; ficha de cría disponible">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CRU_F23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="CRU_F01" sourceRef="CRU_propuesta_datos" targetRef="CRU_propuesta_validar" name=""/>
    <bpmn:sequenceFlow id="CRU_F02" sourceRef="CRU_propuesta_validar" targetRef="CRU_propuesta_valido" name=""/>
    <bpmn:sequenceFlow id="CRU_F03" sourceRef="CRU_propuesta_valido" targetRef="CRU_propuesta_error" name="No"/>
    <bpmn:sequenceFlow id="CRU_F04" sourceRef="CRU_propuesta_error" targetRef="CRU_propuesta_corregir" name=""/>
    <bpmn:sequenceFlow id="CRU_F05" sourceRef="CRU_propuesta_corregir" targetRef="CRU_propuesta_datos" name="Reintentar"/>
    <bpmn:sequenceFlow id="CRU_F06" sourceRef="CRU_inicio" targetRef="CRU_propuesta_datos" name=""/>
    <bpmn:sequenceFlow id="CRU_F07" sourceRef="CRU_propuesta_valido" targetRef="CRU_catalogo" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_validos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CRU_F08" sourceRef="CRU_catalogo" targetRef="CRU_calcular" name=""/>
    <bpmn:sequenceFlow id="CRU_F09" sourceRef="CRU_calcular" targetRef="CRU_reglas" name=""/>
    <bpmn:sequenceFlow id="CRU_F10" sourceRef="CRU_reglas" targetRef="CRU_aviso" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">faltan_reglas</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CRU_F11" sourceRef="CRU_reglas" targetRef="CRU_resultado_listo" name="No"/>
    <bpmn:sequenceFlow id="CRU_F12" sourceRef="CRU_aviso" targetRef="CRU_resultado_listo" name=""/>
    <bpmn:sequenceFlow id="CRU_F13" sourceRef="CRU_resultado_listo" targetRef="CRU_mostrar" name=""/>
    <bpmn:sequenceFlow id="CRU_F14" sourceRef="CRU_mostrar" targetRef="CRU_revisar" name=""/>
    <bpmn:sequenceFlow id="CRU_F15" sourceRef="CRU_revisar" targetRef="CRU_confirma" name=""/>
    <bpmn:sequenceFlow id="CRU_F16" sourceRef="CRU_confirma" targetRef="CRU_propuesta_datos" name="Modificar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision = modificar</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CRU_F17" sourceRef="CRU_confirma" targetRef="CRU_cancelado" name="Cancelar"/>
    <bpmn:sequenceFlow id="CRU_F18" sourceRef="CRU_confirma" targetRef="CRU_revalidar" name="Confirmar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision = confirmar</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CRU_F19" sourceRef="CRU_revalidar" targetRef="CRU_confirmacion_valida" name=""/>
    <bpmn:sequenceFlow id="CRU_F20" sourceRef="CRU_confirmacion_valida" targetRef="CRU_cambio" name="No"/>
    <bpmn:sequenceFlow id="CRU_F21" sourceRef="CRU_cambio" targetRef="CRU_propuesta_datos" name="Corregir propuesta"/>
    <bpmn:sequenceFlow id="CRU_F22" sourceRef="CRU_confirmacion_valida" targetRef="CRU_guardar" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_vigentes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CRU_F23" sourceRef="CRU_guardar" targetRef="CRU_fin" name=""/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_CRU">
    <bpmn:participant id="Participant_CRU" name="TuCriadero — Planificar y registrar un cruce" processRef="Process_CRU"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_CRU" name="Planificar y registrar un cruce">
    <bpmndi:BPMNPlane id="Plane_CRU" bpmnElement="Collaboration_CRU">
