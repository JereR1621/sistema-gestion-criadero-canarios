          <dc:Bounds x="342.79999999999995" y="898" width="254.4000000000001" height="30"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CAT_guardar_di" bpmnElement="CAT_guardar">
        <dc:Bounds x="850.0" y="800.0" width="420" height="140"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CAT_fin_di" bpmnElement="CAT_fin">
        <dc:Bounds x="1036.0" y="1036.0" width="48" height="48"/>
