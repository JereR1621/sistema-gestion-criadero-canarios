<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="TuCriadero_BPMN" targetNamespace="urn:tucriadero:bpmn" exporter="TuCriadero" exporterVersion="1.0">
  <bpmn:process id="Process_FIN" name="Terminar un cruce" isExecutable="false">
    <bpmn:documentation>Precondición: sesión de criador válida. Solo se opera sobre un cruce del propio criadero (RF003).
La fecha de fin no puede ser anterior a la fecha de inicio. El cierre conserva padres, pichones e historial (RF022, DAT-004).
Terminar el cruce no traslada automáticamente a sus integrantes ni finaliza otros cruces de la temporada. Los traslados se registran en el proceso de jaulas y ubicaciones.</bpmn:documentation>
    <bpmn:laneSet id="FIN_lanes">
      <bpmn:lane id="FIN_persona" name="Criador">
        <bpmn:flowNodeRef>FIN_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_cierre_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_cierre_corregir</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="FIN_sistema" name="TuCriadero (aplicación web)">
        <bpmn:flowNodeRef>FIN_cierre_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_cierre_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_cierre_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_cerrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_historial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="FIN_inicio" name="Terminar un cruce">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>FIN_F06</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="FIN_cierre_datos" name="Abrir el cruce e indicar la fecha de fin">
      <bpmn:documentation>SRS-RF022</bpmn:documentation>
      <bpmn:incoming>FIN_F05</bpmn:incoming>
      <bpmn:incoming>FIN_F06</bpmn:incoming>
      <bpmn:outgoing>FIN_F01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="FIN_cierre_validar" name="Validar criadero y fechas de inicio y fin">
      <bpmn:documentation>SRS-RF022</bpmn:documentation>
      <bpmn:incoming>FIN_F01</bpmn:incoming>
      <bpmn:outgoing>FIN_F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="FIN_cierre_valido" name="¿Datos válidos?" gatewayDirection="Diverging" default="FIN_F03">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>FIN_F02</bpmn:incoming>
      <bpmn:outgoing>FIN_F03</bpmn:outgoing>
      <bpmn:outgoing>FIN_F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="FIN_cierre_error" name="Mostrar los errores sin guardar cambios">
      <bpmn:documentation>SRS-RF022</bpmn:documentation>
      <bpmn:incoming>FIN_F03</bpmn:incoming>
      <bpmn:outgoing>FIN_F04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="FIN_cierre_corregir" name="Corregir los datos del formulario">
      <bpmn:documentation>SRS-RF022</bpmn:documentation>
      <bpmn:incoming>FIN_F04</bpmn:incoming>
      <bpmn:outgoing>FIN_F05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="FIN_cerrar" name="Guardar fecha de fin y retirar el cruce de activos">
      <bpmn:documentation>SRS-RF022</bpmn:documentation>
      <bpmn:incoming>FIN_F07</bpmn:incoming>
      <bpmn:outgoing>FIN_F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="FIN_historial" name="Conservar fichas e historial y registrar auditoría">
      <bpmn:documentation>SRS-RF017, SRS-RF022, SRS-RF027</bpmn:documentation>
      <bpmn:incoming>FIN_F08</bpmn:incoming>
      <bpmn:outgoing>FIN_F09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="FIN_fin" name="Cruce terminado; historial disponible">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>FIN_F09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="FIN_F01" sourceRef="FIN_cierre_datos" targetRef="FIN_cierre_validar" name=""/>
    <bpmn:sequenceFlow id="FIN_F02" sourceRef="FIN_cierre_validar" targetRef="FIN_cierre_valido" name=""/>
    <bpmn:sequenceFlow id="FIN_F03" sourceRef="FIN_cierre_valido" targetRef="FIN_cierre_error" name="No"/>
    <bpmn:sequenceFlow id="FIN_F04" sourceRef="FIN_cierre_error" targetRef="FIN_cierre_corregir" name=""/>
    <bpmn:sequenceFlow id="FIN_F05" sourceRef="FIN_cierre_corregir" targetRef="FIN_cierre_datos" name="Reintentar"/>
    <bpmn:sequenceFlow id="FIN_F06" sourceRef="FIN_inicio" targetRef="FIN_cierre_datos" name=""/>
    <bpmn:sequenceFlow id="FIN_F07" sourceRef="FIN_cierre_valido" targetRef="FIN_cerrar" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_validos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="FIN_F08" sourceRef="FIN_cerrar" targetRef="FIN_historial" name=""/>
    <bpmn:sequenceFlow id="FIN_F09" sourceRef="FIN_historial" targetRef="FIN_fin" name=""/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_FIN">
    <bpmn:participant id="Participant_FIN" name="TuCriadero — Terminar un cruce" processRef="Process_FIN"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_FIN" name="Terminar un cruce">
    <bpmndi:BPMNPlane id="Plane_FIN" bpmnElement="Collaboration_FIN">
      <bpmndi:BPMNShape id="Participant_FIN_di" bpmnElement="Participant_FIN" isHorizontal="true">
        <dc:Bounds x="40" y="150" width="1420" height="1265"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FIN_persona_di" bpmnElement="FIN_persona" isHorizontal="false">
        <dc:Bounds x="100" y="150" width="690" height="1265"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FIN_sistema_di" bpmnElement="FIN_sistema" isHorizontal="false">
        <dc:Bounds x="790" y="150" width="670" height="1265"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FIN_inicio_di" bpmnElement="FIN_inicio">
        <dc:Bounds x="416.0" y="276.0" width="48" height="48"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="478.0" y="258" width="285" height="80"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FIN_cierre_datos_di" bpmnElement="FIN_cierre_datos">
        <dc:Bounds x="220.0" y="402.0" width="440" height="116"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FIN_cierre_validar_di" bpmnElement="FIN_cierre_validar">
        <dc:Bounds x="900.0" y="402.0" width="440" height="116"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FIN_cierre_valido_di" bpmnElement="FIN_cierre_valido" isMarkerVisible="true">
        <dc:Bounds x="1086.0" y="586.0" width="68" height="68"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1168.0" y="578" width="285" height="80"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FIN_cierre_error_di" bpmnElement="FIN_cierre_error">
        <dc:Bounds x="900.0" y="722.0" width="440" height="116"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FIN_cierre_corregir_di" bpmnElement="FIN_cierre_corregir">
        <dc:Bounds x="220.0" y="722.0" width="440" height="116"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FIN_cerrar_di" bpmnElement="FIN_cerrar">
        <dc:Bounds x="900.0" y="882.0" width="440" height="116"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FIN_historial_di" bpmnElement="FIN_historial">
        <dc:Bounds x="900.0" y="1042.0" width="440" height="116"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FIN_fin_di" bpmnElement="FIN_fin">
        <dc:Bounds x="1096.0" y="1236.0" width="48" height="48"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="920" y="1300" width="400" height="95"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="FIN_F01_di" bpmnElement="FIN_F01">
        <di:waypoint x="660.0" y="460"/>
        <di:waypoint x="900.0" y="460"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FIN_F02_di" bpmnElement="FIN_F02">
        <di:waypoint x="1120" y="518.0"/>
        <di:waypoint x="1120" y="586.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FIN_F03_di" bpmnElement="FIN_F03">
        <di:waypoint x="1120" y="654.0"/>
        <di:waypoint x="1120" y="722.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1132" y="673.0" width="230" height="28"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FIN_F04_di" bpmnElement="FIN_F04">
        <di:waypoint x="900.0" y="780"/>
        <di:waypoint x="660.0" y="780"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FIN_F05_di" bpmnElement="FIN_F05">
        <di:waypoint x="220.0" y="780"/>
        <di:waypoint x="125" y="780"/>
        <di:waypoint x="125" y="460"/>
        <di:waypoint x="220.0" y="460"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="137" y="686" width="230" height="28"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FIN_F06_di" bpmnElement="FIN_F06">
        <di:waypoint x="440" y="324.0"/>
        <di:waypoint x="440" y="402.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FIN_F07_di" bpmnElement="FIN_F07">
        <di:waypoint x="1154.0" y="620"/>
        <di:waypoint x="1375" y="620"/>
        <di:waypoint x="1375" y="940"/>
        <di:waypoint x="1340.0" y="940"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1272.5" y="630" width="230" height="28"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FIN_F08_di" bpmnElement="FIN_F08">
        <di:waypoint x="1120" y="998.0"/>
        <di:waypoint x="1120" y="1042.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FIN_F09_di" bpmnElement="FIN_F09">
        <di:waypoint x="1120" y="1158.0"/>
        <di:waypoint x="1120" y="1236.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
