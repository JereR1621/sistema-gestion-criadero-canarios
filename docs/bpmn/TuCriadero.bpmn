      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CRU_propuesta_validar_di" bpmnElement="CRU_propuesta_validar">
        <dc:Bounds x="900.0" y="402.0" width="440" height="116"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CRU_propuesta_valido_di" bpmnElement="CRU_propuesta_valido" isMarkerVisible="true">
        <dc:Bounds x="1086.0" y="586.0" width="68" height="68"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1168.0" y="578" width="285" height="80"/>
