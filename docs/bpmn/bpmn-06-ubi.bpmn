      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UBI_mover_validar_di" bpmnElement="UBI_mover_validar">
        <dc:Bounds x="850.0" y="420.0" width="420" height="140"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UBI_mover_valido_di" bpmnElement="UBI_mover_valido" isMarkerVisible="true">
