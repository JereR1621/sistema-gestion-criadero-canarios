        <dc:Bounds x="840" y="1235" width="780" height="250"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CAT_no_disponible_inicio_di" bpmnElement="CAT_no_disponible_inicio">
        <dc:Bounds x="926" y="1336" width="48" height="48"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CAT_no_disponible_informar_di" bpmnElement="CAT_no_disponible_informar">
        <dc:Bounds x="1065.0" y="1308.0" width="330" height="104"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CAT_no_disponible_fin_di" bpmnElement="CAT_no_disponible_fin">
