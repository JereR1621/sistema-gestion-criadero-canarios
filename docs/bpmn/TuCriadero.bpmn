<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="TuCriadero_BPMN" targetNamespace="urn:tucriadero:bpmn" exporter="TuCriadero" exporterVersion="2.0">
  <bpmn:error id="Error_no_disponible" name="Sin conexión, mantenimiento o sesión expirada" errorCode="NO_DISPONIBLE"/>
  <bpmn:process id="Process_TEM" name="Temporada de cría (vista general)" isExecutable="false">
    <bpmn:documentation>Vista general: cada caja de borde grueso es un proceso detallado en la figura indicada. Varios cruces pueden avanzar en paralelo; cada uno sigue esta secuencia.
La espera de 10 a 12 días la decide el criador: el sistema no programa avisos ni temporizadores automáticos.</bpmn:documentation>
    <bpmn:laneSet id="TEM_lanes">
      <bpmn:lane id="TEM_persona" name="Criador">
        <bpmn:flowNodeRef>TEM_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TEM_cru</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TEM_espera</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TEM_pic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TEM_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TEM_otro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TEM_ubi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TEM_fin_temporada</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="TEM_inicio" name="Inicio de la temporada de cría">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>TEM_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="TEM_cru" name="Planificar y registrar un cruce" calledElement="Process_CRU">
      <bpmn:documentation>Detalle en la Figura 4.</bpmn:documentation>
      <bpmn:incoming>TEM_F01</bpmn:incoming>
      <bpmn:incoming>TEM_F06</bpmn:incoming>
      <bpmn:outgoing>TEM_F02</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:intermediateCatchEvent id="TEM_espera" name="Pichones con 10 a 12 días de vida">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>TEM_F02</bpmn:incoming>
      <bpmn:outgoing>TEM_F03</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TEM_espera_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P10D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:callActivity id="TEM_pic" name="Registrar los pichones del cruce" calledElement="Process_PIC">
      <bpmn:documentation>Detalle en la Figura 5.</bpmn:documentation>
      <bpmn:incoming>TEM_F03</bpmn:incoming>
      <bpmn:outgoing>TEM_F04</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="TEM_fin" name="Terminar el cruce" calledElement="Process_FIN">
      <bpmn:documentation>Detalle en la Figura 6.</bpmn:documentation>
      <bpmn:incoming>TEM_F04</bpmn:incoming>
      <bpmn:outgoing>TEM_F05</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="TEM_otro" name="¿Planifica otro cruce?" gatewayDirection="Diverging" default="TEM_F07">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>TEM_F05</bpmn:incoming>
      <bpmn:outgoing>TEM_F06</bpmn:outgoing>
      <bpmn:outgoing>TEM_F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="TEM_ubi" name="Trasladar pichones y adultos a la jaula grande" calledElement="Process_UBI">
      <bpmn:documentation>Detalle en la Figura 8.</bpmn:documentation>
      <bpmn:incoming>TEM_F07</bpmn:incoming>
      <bpmn:outgoing>TEM_F08</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="TEM_fin_temporada" name="Fin de la temporada">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>TEM_F08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="TEM_F01" sourceRef="TEM_inicio" targetRef="TEM_cru" name=""/>
    <bpmn:sequenceFlow id="TEM_F02" sourceRef="TEM_cru" targetRef="TEM_espera" name=""/>
    <bpmn:sequenceFlow id="TEM_F03" sourceRef="TEM_espera" targetRef="TEM_pic" name=""/>
    <bpmn:sequenceFlow id="TEM_F04" sourceRef="TEM_pic" targetRef="TEM_fin" name=""/>
    <bpmn:sequenceFlow id="TEM_F05" sourceRef="TEM_fin" targetRef="TEM_otro" name=""/>
    <bpmn:sequenceFlow id="TEM_F06" sourceRef="TEM_otro" targetRef="TEM_cru" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">otro_cruce</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="TEM_F07" sourceRef="TEM_otro" targetRef="TEM_ubi" name="No"/>
    <bpmn:sequenceFlow id="TEM_F08" sourceRef="TEM_ubi" targetRef="TEM_fin_temporada" name=""/>
    <bpmn:textAnnotation id="TEM_A_espera">
      <bpmn:text>• Entre el cruce y el anillado ocurren la postura y la incubación, que no se registran en el sistema (fuera del alcance).
• El criador anilla los pichones entre los 10 y 12 días de vida (glosario, RF021).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="TEM_A_espera_asoc" sourceRef="TEM_espera" targetRef="TEM_A_espera" associationDirection="None"/>
    <bpmn:textAnnotation id="TEM_A_cualquier">
      <bpmn:text>En cualquier momento, fuera de esta secuencia:
• Registrar canarios (Figura 9).
• Registrar jaulas (Figura 7).
• Buscar y consultar la genealogía (Figura 10).
• Dar de baja un canario (Figura 11).
• Ingreso (Figura 12); cuentas y catálogo, solo el administrador (Figuras 13 y 14).</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_TEM">
    <bpmn:participant id="Participant_TEM" name="TuCriadero — Temporada de cría (vista general)" processRef="Process_TEM"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_CRU" name="Planificar y registrar un cruce" isExecutable="false">
    <bpmn:documentation>Precondición: sesión de criador válida; solo se usan registros del propio criadero (RF002–RF003). Una hembra con varios machos, o un macho con varias hembras, se registran repitiendo el proceso para cada pareja (RF019–RF020).
La vista previa no guarda nada. Los porcentajes siguen SUP-004 (factores independientes, una dosis de los dominantes) y se avisa cuando el resultado es aproximado.</bpmn:documentation>
    <bpmn:laneSet id="CRU_lanes">
      <bpmn:lane id="CRU_persona" name="Criador">
        <bpmn:flowNodeRef>CRU_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_propuesta_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_propuesta_corrige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_propuesta_cancelado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_cancelado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CRU_sistema" name="TuCriadero (aplicación web)">
        <bpmn:flowNodeRef>CRU_propuesta_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_propuesta_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_catalogo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_calcular</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_reglas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_aviso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_mostrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_revalidar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_vigentes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_cambiaron</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_guardar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CRU_no_disponible</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CRU_inicio" name="Planificar un cruce">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>CRU_F06</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="CRU_propuesta_datos" name="Elegir macho, hembra, jaula, temporada y fecha de inicio">
      <bpmn:documentation>SRS-RF018, SRS-RF019, SRS-RF020</bpmn:documentation>
      <bpmn:incoming>CRU_F04</bpmn:incoming>
      <bpmn:incoming>CRU_F06</bpmn:incoming>
      <bpmn:incoming>CRU_F15</bpmn:incoming>
      <bpmn:outgoing>CRU_F01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CRU_propuesta_validar" name="Validar progenitores, sexo, jaula y criadero">
      <bpmn:documentation>SRS-RF018, SRS-RF019, SRS-RF020</bpmn:documentation>
      <bpmn:incoming>CRU_F01</bpmn:incoming>
      <bpmn:outgoing>CRU_F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CRU_propuesta_valido" name="¿Datos válidos?" gatewayDirection="Diverging" default="CRU_F03">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CRU_F02</bpmn:incoming>
      <bpmn:outgoing>CRU_F03</bpmn:outgoing>
      <bpmn:outgoing>CRU_F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="CRU_propuesta_corrige" name="¿Corrige los datos?" gatewayDirection="Diverging" default="CRU_F05">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CRU_F03</bpmn:incoming>
      <bpmn:outgoing>CRU_F04</bpmn:outgoing>
      <bpmn:outgoing>CRU_F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="CRU_propuesta_cancelado" name="Planificación cancelada; sin cruce guardado">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CRU_F05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="CRU_catalogo" name="Obtener factores manifestados, portados y tipo de herencia">
      <bpmn:documentation>SRS-RF031, SRS-RF033, SRS-RF034</bpmn:documentation>
      <bpmn:incoming>CRU_F07</bpmn:incoming>
      <bpmn:outgoing>CRU_F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CRU_calcular" name="Calcular los porcentajes por sexo con las reglas del catálogo">
      <bpmn:documentation>SRS-RF035, SRS-RF036, SRS-RF037, SRS-RF038</bpmn:documentation>
      <bpmn:incoming>CRU_F08</bpmn:incoming>
      <bpmn:outgoing>CRU_F09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CRU_reglas" name="¿Hay factores sin regla de herencia?" gatewayDirection="Diverging" default="CRU_F12">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CRU_F09</bpmn:incoming>
      <bpmn:outgoing>CRU_F10</bpmn:outgoing>
      <bpmn:outgoing>CRU_F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CRU_aviso" name="Agregar el aviso de factores no calculables">
      <bpmn:documentation>SRS-RF039</bpmn:documentation>
      <bpmn:incoming>CRU_F10</bpmn:incoming>
      <bpmn:outgoing>CRU_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CRU_mostrar" name="Mostrar el posible resultado por sexo y los avisos">
      <bpmn:documentation>SRS-RF035, SRS-RF039</bpmn:documentation>
      <bpmn:incoming>CRU_F11</bpmn:incoming>
      <bpmn:incoming>CRU_F12</bpmn:incoming>
      <bpmn:outgoing>CRU_F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="CRU_revisar" name="Revisar el posible resultado y decidir">
      <bpmn:documentation>SRS-RF035</bpmn:documentation>
      <bpmn:incoming>CRU_F13</bpmn:incoming>
      <bpmn:outgoing>CRU_F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CRU_decide" name="¿Qué decide?" gatewayDirection="Diverging" default="CRU_F17">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CRU_F14</bpmn:incoming>
      <bpmn:outgoing>CRU_F15</bpmn:outgoing>
      <bpmn:outgoing>CRU_F16</bpmn:outgoing>
      <bpmn:outgoing>CRU_F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CRU_revalidar" name="Revalidar los datos al confirmar">
      <bpmn:documentation>SRS-RF018</bpmn:documentation>
      <bpmn:incoming>CRU_F16</bpmn:incoming>
      <bpmn:outgoing>CRU_F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CRU_cancelado" name="Propuesta cancelada; sin cruce guardado">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CRU_F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="CRU_vigentes" name="¿Datos vigentes?" gatewayDirection="Diverging" default="CRU_F19">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CRU_F18</bpmn:incoming>
      <bpmn:outgoing>CRU_F19</bpmn:outgoing>
      <bpmn:outgoing>CRU_F20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="CRU_cambiaron" name="No guardado: un progenitor o la jaula cambió">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CRU_F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="CRU_guardar" name="Registrar el cruce con su fecha de inicio y auditar">
      <bpmn:documentation>SRS-RF018, SRS-RF019, SRS-RF020</bpmn:documentation>
      <bpmn:incoming>CRU_F20</bpmn:incoming>
      <bpmn:outgoing>CRU_F21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CRU_fin" name="Cruce registrado; ficha de cría disponible">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CRU_F21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="CRU_F01" sourceRef="CRU_propuesta_datos" targetRef="CRU_propuesta_validar" name=""/>
    <bpmn:sequenceFlow id="CRU_F02" sourceRef="CRU_propuesta_validar" targetRef="CRU_propuesta_valido" name=""/>
    <bpmn:sequenceFlow id="CRU_F03" sourceRef="CRU_propuesta_valido" targetRef="CRU_propuesta_corrige" name="No"/>
    <bpmn:sequenceFlow id="CRU_F04" sourceRef="CRU_propuesta_corrige" targetRef="CRU_propuesta_datos" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">corrige</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CRU_F05" sourceRef="CRU_propuesta_corrige" targetRef="CRU_propuesta_cancelado" name="No"/>
    <bpmn:sequenceFlow id="CRU_F06" sourceRef="CRU_inicio" targetRef="CRU_propuesta_datos" name=""/>
    <bpmn:sequenceFlow id="CRU_F07" sourceRef="CRU_propuesta_valido" targetRef="CRU_catalogo" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_validos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CRU_F08" sourceRef="CRU_catalogo" targetRef="CRU_calcular" name=""/>
    <bpmn:sequenceFlow id="CRU_F09" sourceRef="CRU_calcular" targetRef="CRU_reglas" name=""/>
    <bpmn:sequenceFlow id="CRU_F10" sourceRef="CRU_reglas" targetRef="CRU_aviso" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">faltan_reglas</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CRU_F11" sourceRef="CRU_aviso" targetRef="CRU_mostrar" name=""/>
    <bpmn:sequenceFlow id="CRU_F12" sourceRef="CRU_reglas" targetRef="CRU_mostrar" name="No"/>
    <bpmn:sequenceFlow id="CRU_F13" sourceRef="CRU_mostrar" targetRef="CRU_revisar" name=""/>
    <bpmn:sequenceFlow id="CRU_F14" sourceRef="CRU_revisar" targetRef="CRU_decide" name=""/>
    <bpmn:sequenceFlow id="CRU_F15" sourceRef="CRU_decide" targetRef="CRU_propuesta_datos" name="Modificar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision = modificar</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CRU_F16" sourceRef="CRU_decide" targetRef="CRU_revalidar" name="Confirmar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision = confirmar</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CRU_F17" sourceRef="CRU_decide" targetRef="CRU_cancelado" name="Cancelar"/>
    <bpmn:sequenceFlow id="CRU_F18" sourceRef="CRU_revalidar" targetRef="CRU_vigentes" name=""/>
    <bpmn:sequenceFlow id="CRU_F19" sourceRef="CRU_vigentes" targetRef="CRU_cambiaron" name="No"/>
    <bpmn:sequenceFlow id="CRU_F20" sourceRef="CRU_vigentes" targetRef="CRU_guardar" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_vigentes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CRU_F21" sourceRef="CRU_guardar" targetRef="CRU_fin" name=""/>
    <bpmn:subProcess id="CRU_no_disponible" name="Sin conexión, mantenimiento o sesión expirada" triggeredByEvent="true">
      <bpmn:startEvent id="CRU_no_disponible_inicio" name="Sin conexión, mantenimiento o sesión expirada" isInterrupting="true">
        <bpmn:outgoing>CRU_no_disponible_F1</bpmn:outgoing>
        <bpmn:errorEventDefinition id="CRU_no_disponible_err" errorRef="Error_no_disponible"/>
      </bpmn:startEvent>
      <bpmn:serviceTask id="CRU_no_disponible_informar" name="Informar el motivo y no guardar cambios">
        <bpmn:documentation>SRS §2.5 (modo degradado y mantenimiento) y SEG-004 (sesión).</bpmn:documentation>
        <bpmn:incoming>CRU_no_disponible_F1</bpmn:incoming>
        <bpmn:outgoing>CRU_no_disponible_F2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="CRU_no_disponible_fin" name="Operación no realizada; sin cambios">
        <bpmn:incoming>CRU_no_disponible_F2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="CRU_no_disponible_F1" sourceRef="CRU_no_disponible_inicio" targetRef="CRU_no_disponible_informar"/>
      <bpmn:sequenceFlow id="CRU_no_disponible_F2" sourceRef="CRU_no_disponible_informar" targetRef="CRU_no_disponible_fin"/>
    </bpmn:subProcess>
    <bpmn:textAnnotation id="CRU_A_propuesta">
      <bpmn:text>Errores que se informan sin guardar:
• Macho o hembra sin sexo registrado, o con un sexo que no corresponde (RF018).
• Canario o jaula de otro criadero (RF003, DAT-004).
• Falta un dato obligatorio (RF018).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="CRU_A_propuesta_asoc" sourceRef="CRU_propuesta_valido" targetRef="CRU_A_propuesta" associationDirection="None"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_CRU">
    <bpmn:participant id="Participant_CRU" name="TuCriadero — Planificar y registrar un cruce" processRef="Process_CRU"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_PIC" name="Registrar pichones de un cruce" isExecutable="false">
    <bpmn:documentation>Precondición: sesión de criador válida; el cruce y sus progenitores son del propio criadero (RF003, DAT-004). Se registra cuando los pichones tienen entre 10 y 12 días (Figura 3).
Sexo y variedad pueden quedar sin determinar y la fecha de nacimiento es opcional (RF007, RF021). Registrar pichones no termina el cruce (RF022).</bpmn:documentation>
    <bpmn:laneSet id="PIC_lanes">
      <bpmn:lane id="PIC_persona" name="Criador">
        <bpmn:flowNodeRef>PIC_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_elegir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_anillos_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_anillos_corrige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_anillos_cancelado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_mas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PIC_sistema" name="TuCriadero (aplicación web)">
        <bpmn:flowNodeRef>PIC_cruce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_anillos_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_anillos_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_fichas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_factores</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_mostrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIC_no_disponible</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PIC_inicio" name="Registrar pichones">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>PIC_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="PIC_elegir" name="Elegir un cruce activo y abrir su ficha de cría">
      <bpmn:documentation>SRS-RF027</bpmn:documentation>
      <bpmn:incoming>PIC_F01</bpmn:incoming>
      <bpmn:outgoing>PIC_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PIC_cruce" name="Obtener el cruce, sus progenitores y los datos por defecto">
      <bpmn:documentation>SRS-RF004, SRS-RF027</bpmn:documentation>
      <bpmn:incoming>PIC_F02</bpmn:incoming>
      <bpmn:outgoing>PIC_F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PIC_anillos_datos" name="Ingresar los anillos y las fechas de los pichones">
      <bpmn:documentation>SRS-RF007, SRS-RF008, SRS-RF012, SRS-RF021</bpmn:documentation>
      <bpmn:incoming>PIC_F06</bpmn:incoming>
      <bpmn:incoming>PIC_F08</bpmn:incoming>
      <bpmn:incoming>PIC_F14</bpmn:incoming>
      <bpmn:outgoing>PIC_F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PIC_anillos_validar" name="Validar anillos, sexo, variedad y fechas">
      <bpmn:documentation>SRS-RF007, SRS-RF008, SRS-RF012, SRS-RF021</bpmn:documentation>
      <bpmn:incoming>PIC_F03</bpmn:incoming>
      <bpmn:outgoing>PIC_F04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="PIC_anillos_valido" name="¿Datos válidos?" gatewayDirection="Diverging" default="PIC_F05">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>PIC_F04</bpmn:incoming>
      <bpmn:outgoing>PIC_F05</bpmn:outgoing>
      <bpmn:outgoing>PIC_F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="PIC_anillos_corrige" name="¿Corrige los datos?" gatewayDirection="Diverging" default="PIC_F07">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>PIC_F05</bpmn:incoming>
      <bpmn:outgoing>PIC_F06</bpmn:outgoing>
      <bpmn:outgoing>PIC_F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="PIC_anillos_cancelado" name="Registro cancelado; sin pichones nuevos">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>PIC_F07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="PIC_fichas" name="Crear las fichas con padre, madre y cruce de origen">
      <bpmn:documentation>SRS-RF021</bpmn:documentation>
      <bpmn:incoming>PIC_F09</bpmn:incoming>
      <bpmn:outgoing>PIC_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PIC_factores" name="Obtener los factores manifestados y deducir los portadores">
      <bpmn:documentation>SRS-RF033, SRS-RF034</bpmn:documentation>
      <bpmn:incoming>PIC_F10</bpmn:incoming>
      <bpmn:outgoing>PIC_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PIC_mostrar" name="Actualizar la ficha de cría y registrar auditoría">
      <bpmn:documentation>SRS-RF021, SRS-RF027</bpmn:documentation>
      <bpmn:incoming>PIC_F11</bpmn:incoming>
      <bpmn:outgoing>PIC_F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PIC_revisar" name="Revisar las fichas creadas">
      <bpmn:documentation>SRS-RF021, SRS-RF027</bpmn:documentation>
      <bpmn:incoming>PIC_F12</bpmn:incoming>
      <bpmn:outgoing>PIC_F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PIC_mas" name="¿Registra más pichones?" gatewayDirection="Diverging" default="PIC_F15">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>PIC_F13</bpmn:incoming>
      <bpmn:outgoing>PIC_F14</bpmn:outgoing>
      <bpmn:outgoing>PIC_F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="PIC_fin" name="Pichones registrados; el cruce sigue activo">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>PIC_F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="PIC_F01" sourceRef="PIC_inicio" targetRef="PIC_elegir" name=""/>
    <bpmn:sequenceFlow id="PIC_F02" sourceRef="PIC_elegir" targetRef="PIC_cruce" name=""/>
    <bpmn:sequenceFlow id="PIC_F03" sourceRef="PIC_anillos_datos" targetRef="PIC_anillos_validar" name=""/>
    <bpmn:sequenceFlow id="PIC_F04" sourceRef="PIC_anillos_validar" targetRef="PIC_anillos_valido" name=""/>
    <bpmn:sequenceFlow id="PIC_F05" sourceRef="PIC_anillos_valido" targetRef="PIC_anillos_corrige" name="No"/>
    <bpmn:sequenceFlow id="PIC_F06" sourceRef="PIC_anillos_corrige" targetRef="PIC_anillos_datos" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">corrige</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PIC_F07" sourceRef="PIC_anillos_corrige" targetRef="PIC_anillos_cancelado" name="No"/>
    <bpmn:sequenceFlow id="PIC_F08" sourceRef="PIC_cruce" targetRef="PIC_anillos_datos" name=""/>
    <bpmn:sequenceFlow id="PIC_F09" sourceRef="PIC_anillos_valido" targetRef="PIC_fichas" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_validos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PIC_F10" sourceRef="PIC_fichas" targetRef="PIC_factores" name=""/>
    <bpmn:sequenceFlow id="PIC_F11" sourceRef="PIC_factores" targetRef="PIC_mostrar" name=""/>
    <bpmn:sequenceFlow id="PIC_F12" sourceRef="PIC_mostrar" targetRef="PIC_revisar" name=""/>
    <bpmn:sequenceFlow id="PIC_F13" sourceRef="PIC_revisar" targetRef="PIC_mas" name=""/>
    <bpmn:sequenceFlow id="PIC_F14" sourceRef="PIC_mas" targetRef="PIC_anillos_datos" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">mas_pichones</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PIC_F15" sourceRef="PIC_mas" targetRef="PIC_fin" name="No"/>
    <bpmn:subProcess id="PIC_no_disponible" name="Sin conexión, mantenimiento o sesión expirada" triggeredByEvent="true">
      <bpmn:startEvent id="PIC_no_disponible_inicio" name="Sin conexión, mantenimiento o sesión expirada" isInterrupting="true">
        <bpmn:outgoing>PIC_no_disponible_F1</bpmn:outgoing>
        <bpmn:errorEventDefinition id="PIC_no_disponible_err" errorRef="Error_no_disponible"/>
      </bpmn:startEvent>
      <bpmn:serviceTask id="PIC_no_disponible_informar" name="Informar el motivo y no guardar cambios">
        <bpmn:documentation>SRS §2.5 (modo degradado y mantenimiento) y SEG-004 (sesión).</bpmn:documentation>
        <bpmn:incoming>PIC_no_disponible_F1</bpmn:incoming>
        <bpmn:outgoing>PIC_no_disponible_F2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="PIC_no_disponible_fin" name="Operación no realizada; sin cambios">
        <bpmn:incoming>PIC_no_disponible_F2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="PIC_no_disponible_F1" sourceRef="PIC_no_disponible_inicio" targetRef="PIC_no_disponible_informar"/>
      <bpmn:sequenceFlow id="PIC_no_disponible_F2" sourceRef="PIC_no_disponible_informar" targetRef="PIC_no_disponible_fin"/>
    </bpmn:subProcess>
    <bpmn:textAnnotation id="PIC_A_anillos">
      <bpmn:text>Errores que se informan sin guardar:
• Anillo ya usado en el criadero o repetido en el envío: se indica el canario que lo usa (RF008).
• Variedad que no corresponde al sexo (RF012).
• Falta la fecha de anillado (RF021).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="PIC_A_anillos_asoc" sourceRef="PIC_anillos_valido" targetRef="PIC_A_anillos" associationDirection="None"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_PIC">
    <bpmn:participant id="Participant_PIC" name="TuCriadero — Registrar pichones de un cruce" processRef="Process_PIC"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_FIN" name="Terminar un cruce" isExecutable="false">
    <bpmn:documentation>Precondición: sesión de criador válida; el cruce es del propio criadero (RF003).
Terminar el cruce no traslada a sus integrantes: los traslados se registran en la Figura 8. Se conservan padres, pichones e historial (RF022, DAT-004).</bpmn:documentation>
    <bpmn:laneSet id="FIN_lanes">
      <bpmn:lane id="FIN_persona" name="Criador">
        <bpmn:flowNodeRef>FIN_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_cierre_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_cierre_corrige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_cierre_cancelado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="FIN_sistema" name="TuCriadero (aplicación web)">
        <bpmn:flowNodeRef>FIN_cierre_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_cierre_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_cerrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_historial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIN_no_disponible</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="FIN_inicio" name="Terminar un cruce">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>FIN_F06</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="FIN_cierre_datos" name="Abrir el cruce activo e indicar la fecha de fin">
      <bpmn:documentation>SRS-RF022</bpmn:documentation>
      <bpmn:incoming>FIN_F04</bpmn:incoming>
      <bpmn:incoming>FIN_F06</bpmn:incoming>
      <bpmn:outgoing>FIN_F01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="FIN_cierre_validar" name="Validar el cruce y las fechas">
      <bpmn:documentation>SRS-RF022</bpmn:documentation>
      <bpmn:incoming>FIN_F01</bpmn:incoming>
      <bpmn:outgoing>FIN_F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="FIN_cierre_valido" name="¿Datos válidos?" gatewayDirection="Diverging" default="FIN_F03">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>FIN_F02</bpmn:incoming>
      <bpmn:outgoing>FIN_F03</bpmn:outgoing>
      <bpmn:outgoing>FIN_F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="FIN_cierre_corrige" name="¿Corrige los datos?" gatewayDirection="Diverging" default="FIN_F05">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>FIN_F03</bpmn:incoming>
      <bpmn:outgoing>FIN_F04</bpmn:outgoing>
      <bpmn:outgoing>FIN_F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="FIN_cierre_cancelado" name="Cierre cancelado; el cruce sigue activo">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>FIN_F05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="FIN_cerrar" name="Guardar la fecha de fin y retirar el cruce de los activos">
      <bpmn:documentation>SRS-RF022</bpmn:documentation>
      <bpmn:incoming>FIN_F07</bpmn:incoming>
      <bpmn:outgoing>FIN_F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="FIN_historial" name="Conservar la ficha de cría y el historial y auditar">
      <bpmn:documentation>SRS-RF017, SRS-RF022, SRS-RF027</bpmn:documentation>
      <bpmn:incoming>FIN_F08</bpmn:incoming>
      <bpmn:outgoing>FIN_F09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="FIN_fin" name="Cruce terminado; historial disponible">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>FIN_F09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="FIN_F01" sourceRef="FIN_cierre_datos" targetRef="FIN_cierre_validar" name=""/>
    <bpmn:sequenceFlow id="FIN_F02" sourceRef="FIN_cierre_validar" targetRef="FIN_cierre_valido" name=""/>
    <bpmn:sequenceFlow id="FIN_F03" sourceRef="FIN_cierre_valido" targetRef="FIN_cierre_corrige" name="No"/>
    <bpmn:sequenceFlow id="FIN_F04" sourceRef="FIN_cierre_corrige" targetRef="FIN_cierre_datos" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">corrige</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="FIN_F05" sourceRef="FIN_cierre_corrige" targetRef="FIN_cierre_cancelado" name="No"/>
    <bpmn:sequenceFlow id="FIN_F06" sourceRef="FIN_inicio" targetRef="FIN_cierre_datos" name=""/>
    <bpmn:sequenceFlow id="FIN_F07" sourceRef="FIN_cierre_valido" targetRef="FIN_cerrar" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_validos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="FIN_F08" sourceRef="FIN_cerrar" targetRef="FIN_historial" name=""/>
    <bpmn:sequenceFlow id="FIN_F09" sourceRef="FIN_historial" targetRef="FIN_fin" name=""/>
    <bpmn:subProcess id="FIN_no_disponible" name="Sin conexión, mantenimiento o sesión expirada" triggeredByEvent="true">
      <bpmn:startEvent id="FIN_no_disponible_inicio" name="Sin conexión, mantenimiento o sesión expirada" isInterrupting="true">
        <bpmn:outgoing>FIN_no_disponible_F1</bpmn:outgoing>
        <bpmn:errorEventDefinition id="FIN_no_disponible_err" errorRef="Error_no_disponible"/>
      </bpmn:startEvent>
      <bpmn:serviceTask id="FIN_no_disponible_informar" name="Informar el motivo y no guardar cambios">
        <bpmn:documentation>SRS §2.5 (modo degradado y mantenimiento) y SEG-004 (sesión).</bpmn:documentation>
        <bpmn:incoming>FIN_no_disponible_F1</bpmn:incoming>
        <bpmn:outgoing>FIN_no_disponible_F2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="FIN_no_disponible_fin" name="Operación no realizada; sin cambios">
        <bpmn:incoming>FIN_no_disponible_F2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="FIN_no_disponible_F1" sourceRef="FIN_no_disponible_inicio" targetRef="FIN_no_disponible_informar"/>
      <bpmn:sequenceFlow id="FIN_no_disponible_F2" sourceRef="FIN_no_disponible_informar" targetRef="FIN_no_disponible_fin"/>
    </bpmn:subProcess>
    <bpmn:textAnnotation id="FIN_A_cierre">
      <bpmn:text>Errores que se informan sin guardar:
• Fecha de fin anterior a la fecha de inicio (DAT-004).
• Cruce ya terminado o de otro criadero (RF003, RF022).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="FIN_A_cierre_asoc" sourceRef="FIN_cierre_valido" targetRef="FIN_A_cierre" associationDirection="None"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_FIN">
    <bpmn:participant id="Participant_FIN" name="TuCriadero — Terminar un cruce" processRef="Process_FIN"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_JAU" name="Registrar una jaula" isExecutable="false">
    <bpmn:documentation>Precondición: sesión de criador válida. El número de jaula es único dentro del criadero (RF014, DAT-004). La jaula grande no se registra: es la ubicación sin número (RF016).</bpmn:documentation>
    <bpmn:laneSet id="JAU_lanes">
      <bpmn:lane id="JAU_persona" name="Criador">
        <bpmn:flowNodeRef>JAU_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_nueva_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_nueva_corrige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_nueva_cancelado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="JAU_sistema" name="TuCriadero (aplicación web)">
        <bpmn:flowNodeRef>JAU_nueva_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_nueva_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_alta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JAU_no_disponible</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="JAU_inicio" name="Registrar una jaula">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>JAU_F06</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="JAU_nueva_datos" name="Ingresar el número de la nueva jaula">
      <bpmn:documentation>SRS-RF014</bpmn:documentation>
      <bpmn:incoming>JAU_F04</bpmn:incoming>
      <bpmn:incoming>JAU_F06</bpmn:incoming>
      <bpmn:outgoing>JAU_F01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="JAU_nueva_validar" name="Validar que el número no exista en el criadero">
      <bpmn:documentation>SRS-RF014</bpmn:documentation>
      <bpmn:incoming>JAU_F01</bpmn:incoming>
      <bpmn:outgoing>JAU_F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="JAU_nueva_valido" name="¿Datos válidos?" gatewayDirection="Diverging" default="JAU_F03">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>JAU_F02</bpmn:incoming>
      <bpmn:outgoing>JAU_F03</bpmn:outgoing>
      <bpmn:outgoing>JAU_F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="JAU_nueva_corrige" name="¿Corrige los datos?" gatewayDirection="Diverging" default="JAU_F05">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>JAU_F03</bpmn:incoming>
      <bpmn:outgoing>JAU_F04</bpmn:outgoing>
      <bpmn:outgoing>JAU_F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="JAU_nueva_cancelado" name="Registro cancelado; sin jaula nueva">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>JAU_F05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="JAU_alta" name="Registrar la jaula numerada">
      <bpmn:documentation>SRS-RF014</bpmn:documentation>
      <bpmn:incoming>JAU_F07</bpmn:incoming>
      <bpmn:outgoing>JAU_F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="JAU_fin" name="Jaula registrada">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>JAU_F08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="JAU_F01" sourceRef="JAU_nueva_datos" targetRef="JAU_nueva_validar" name=""/>
    <bpmn:sequenceFlow id="JAU_F02" sourceRef="JAU_nueva_validar" targetRef="JAU_nueva_valido" name=""/>
    <bpmn:sequenceFlow id="JAU_F03" sourceRef="JAU_nueva_valido" targetRef="JAU_nueva_corrige" name="No"/>
    <bpmn:sequenceFlow id="JAU_F04" sourceRef="JAU_nueva_corrige" targetRef="JAU_nueva_datos" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">corrige</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="JAU_F05" sourceRef="JAU_nueva_corrige" targetRef="JAU_nueva_cancelado" name="No"/>
    <bpmn:sequenceFlow id="JAU_F06" sourceRef="JAU_inicio" targetRef="JAU_nueva_datos" name=""/>
    <bpmn:sequenceFlow id="JAU_F07" sourceRef="JAU_nueva_valido" targetRef="JAU_alta" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_validos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="JAU_F08" sourceRef="JAU_alta" targetRef="JAU_fin" name=""/>
    <bpmn:subProcess id="JAU_no_disponible" name="Sin conexión, mantenimiento o sesión expirada" triggeredByEvent="true">
      <bpmn:startEvent id="JAU_no_disponible_inicio" name="Sin conexión, mantenimiento o sesión expirada" isInterrupting="true">
        <bpmn:outgoing>JAU_no_disponible_F1</bpmn:outgoing>
        <bpmn:errorEventDefinition id="JAU_no_disponible_err" errorRef="Error_no_disponible"/>
      </bpmn:startEvent>
      <bpmn:serviceTask id="JAU_no_disponible_informar" name="Informar el motivo y no guardar cambios">
        <bpmn:documentation>SRS §2.5 (modo degradado y mantenimiento) y SEG-004 (sesión).</bpmn:documentation>
        <bpmn:incoming>JAU_no_disponible_F1</bpmn:incoming>
        <bpmn:outgoing>JAU_no_disponible_F2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="JAU_no_disponible_fin" name="Operación no realizada; sin cambios">
        <bpmn:incoming>JAU_no_disponible_F2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="JAU_no_disponible_F1" sourceRef="JAU_no_disponible_inicio" targetRef="JAU_no_disponible_informar"/>
      <bpmn:sequenceFlow id="JAU_no_disponible_F2" sourceRef="JAU_no_disponible_informar" targetRef="JAU_no_disponible_fin"/>
    </bpmn:subProcess>
    <bpmn:textAnnotation id="JAU_A_nueva">
      <bpmn:text>Errores que se informan sin guardar:
• Número de jaula ya registrado en el criadero (RF014).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="JAU_A_nueva_asoc" sourceRef="JAU_nueva_valido" targetRef="JAU_A_nueva" associationDirection="None"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_JAU">
    <bpmn:participant id="Participant_JAU" name="TuCriadero — Registrar una jaula" processRef="Process_JAU"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_UBI" name="Asignar o trasladar un canario" isExecutable="false">
    <bpmn:documentation>Precondición: sesión de criador válida; canario y jaula del propio criadero (RF003, DAT-004).
La jaula grande es la ubicación sin número. Cada canario tiene como máximo una ubicación abierta: el traslado cierra la anterior (RF015, RF016, DAT-004).</bpmn:documentation>
    <bpmn:laneSet id="UBI_lanes">
      <bpmn:lane id="UBI_persona" name="Criador">
        <bpmn:flowNodeRef>UBI_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UBI_mover_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UBI_mover_corrige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UBI_mover_cancelado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="UBI_sistema" name="TuCriadero (aplicación web)">
        <bpmn:flowNodeRef>UBI_mover_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UBI_mover_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UBI_mover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UBI_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UBI_no_disponible</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="UBI_inicio" name="Asignar o trasladar un canario">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>UBI_F06</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UBI_mover_datos" name="Elegir el canario, el destino y la fecha del movimiento">
      <bpmn:documentation>SRS-RF015, SRS-RF016</bpmn:documentation>
      <bpmn:incoming>UBI_F04</bpmn:incoming>
      <bpmn:incoming>UBI_F06</bpmn:incoming>
      <bpmn:outgoing>UBI_F01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="UBI_mover_validar" name="Validar el canario, el destino y el criadero">
      <bpmn:documentation>SRS-RF015, SRS-RF016</bpmn:documentation>
      <bpmn:incoming>UBI_F01</bpmn:incoming>
      <bpmn:outgoing>UBI_F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="UBI_mover_valido" name="¿Datos válidos?" gatewayDirection="Diverging" default="UBI_F03">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>UBI_F02</bpmn:incoming>
      <bpmn:outgoing>UBI_F03</bpmn:outgoing>
      <bpmn:outgoing>UBI_F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="UBI_mover_corrige" name="¿Corrige los datos?" gatewayDirection="Diverging" default="UBI_F05">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>UBI_F03</bpmn:incoming>
      <bpmn:outgoing>UBI_F04</bpmn:outgoing>
      <bpmn:outgoing>UBI_F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="UBI_mover_cancelado" name="Movimiento cancelado; ubicación sin cambios">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>UBI_F05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="UBI_mover" name="Cerrar la ubicación anterior y abrir la nueva">
      <bpmn:documentation>SRS-RF015, SRS-RF016</bpmn:documentation>
      <bpmn:incoming>UBI_F07</bpmn:incoming>
      <bpmn:outgoing>UBI_F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="UBI_fin" name="Canario ubicado; historial de la jaula actualizado">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>UBI_F08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="UBI_F01" sourceRef="UBI_mover_datos" targetRef="UBI_mover_validar" name=""/>
    <bpmn:sequenceFlow id="UBI_F02" sourceRef="UBI_mover_validar" targetRef="UBI_mover_valido" name=""/>
    <bpmn:sequenceFlow id="UBI_F03" sourceRef="UBI_mover_valido" targetRef="UBI_mover_corrige" name="No"/>
    <bpmn:sequenceFlow id="UBI_F04" sourceRef="UBI_mover_corrige" targetRef="UBI_mover_datos" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">corrige</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="UBI_F05" sourceRef="UBI_mover_corrige" targetRef="UBI_mover_cancelado" name="No"/>
    <bpmn:sequenceFlow id="UBI_F06" sourceRef="UBI_inicio" targetRef="UBI_mover_datos" name=""/>
    <bpmn:sequenceFlow id="UBI_F07" sourceRef="UBI_mover_valido" targetRef="UBI_mover" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_validos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="UBI_F08" sourceRef="UBI_mover" targetRef="UBI_fin" name=""/>
    <bpmn:subProcess id="UBI_no_disponible" name="Sin conexión, mantenimiento o sesión expirada" triggeredByEvent="true">
      <bpmn:startEvent id="UBI_no_disponible_inicio" name="Sin conexión, mantenimiento o sesión expirada" isInterrupting="true">
        <bpmn:outgoing>UBI_no_disponible_F1</bpmn:outgoing>
        <bpmn:errorEventDefinition id="UBI_no_disponible_err" errorRef="Error_no_disponible"/>
      </bpmn:startEvent>
      <bpmn:serviceTask id="UBI_no_disponible_informar" name="Informar el motivo y no guardar cambios">
        <bpmn:documentation>SRS §2.5 (modo degradado y mantenimiento) y SEG-004 (sesión).</bpmn:documentation>
        <bpmn:incoming>UBI_no_disponible_F1</bpmn:incoming>
        <bpmn:outgoing>UBI_no_disponible_F2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="UBI_no_disponible_fin" name="Operación no realizada; sin cambios">
        <bpmn:incoming>UBI_no_disponible_F2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="UBI_no_disponible_F1" sourceRef="UBI_no_disponible_inicio" targetRef="UBI_no_disponible_informar"/>
      <bpmn:sequenceFlow id="UBI_no_disponible_F2" sourceRef="UBI_no_disponible_informar" targetRef="UBI_no_disponible_fin"/>
    </bpmn:subProcess>
    <bpmn:textAnnotation id="UBI_A_mover">
      <bpmn:text>Errores que se informan sin guardar:
• Canario o jaula de otro criadero (RF003, DAT-004).
• Falta el canario, el destino o la fecha (RF015).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="UBI_A_mover_asoc" sourceRef="UBI_mover_valido" targetRef="UBI_A_mover" associationDirection="None"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_UBI">
    <bpmn:participant id="Participant_UBI" name="TuCriadero — Asignar o trasladar un canario" processRef="Process_UBI"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_CAN" name="Registrar o actualizar un canario" isExecutable="false">
    <bpmn:documentation>Precondición: sesión de criador válida; el canario y sus padres, si existen, son del propio criadero (RF003, DAT-004).
Un canario comprado puede no tener padres y registra su procedencia. Sexo y variedad admiten "sin determinar" (RF007–RF010). Al cambiar sexo, variedad o padres solo se recalculan los portadores deducidos (RF034).</bpmn:documentation>
    <bpmn:laneSet id="CAN_lanes">
      <bpmn:lane id="CAN_persona" name="Criador">
        <bpmn:flowNodeRef>CAN_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CAN_ficha_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CAN_ficha_corrige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CAN_ficha_cancelado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CAN_sistema" name="TuCriadero (aplicación web)">
        <bpmn:flowNodeRef>CAN_ficha_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CAN_ficha_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CAN_guardar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CAN_manifestados</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CAN_deducidos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CAN_mostrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CAN_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CAN_no_disponible</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CAN_inicio" name="Registrar o editar un canario">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>CAN_F06</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="CAN_ficha_datos" name="Completar la ficha del canario y los portadores conocidos">
      <bpmn:documentation>SRS-RF007, SRS-RF008, SRS-RF009, SRS-RF010, SRS-RF012, SRS-RF013, SRS-RF029</bpmn:documentation>
      <bpmn:incoming>CAN_F04</bpmn:incoming>
      <bpmn:incoming>CAN_F06</bpmn:incoming>
      <bpmn:outgoing>CAN_F01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CAN_ficha_validar" name="Validar anillo, sexo, variedad, padres y portadores">
      <bpmn:documentation>SRS-RF007, SRS-RF008, SRS-RF009, SRS-RF010, SRS-RF012, SRS-RF013, SRS-RF029</bpmn:documentation>
      <bpmn:incoming>CAN_F01</bpmn:incoming>
      <bpmn:outgoing>CAN_F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CAN_ficha_valido" name="¿Datos válidos?" gatewayDirection="Diverging" default="CAN_F03">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CAN_F02</bpmn:incoming>
      <bpmn:outgoing>CAN_F03</bpmn:outgoing>
      <bpmn:outgoing>CAN_F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="CAN_ficha_corrige" name="¿Corrige los datos?" gatewayDirection="Diverging" default="CAN_F05">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CAN_F03</bpmn:incoming>
      <bpmn:outgoing>CAN_F04</bpmn:outgoing>
      <bpmn:outgoing>CAN_F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="CAN_ficha_cancelado" name="Edición cancelada; ficha sin cambios">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CAN_F05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="CAN_guardar" name="Guardar la ficha y los portadores indicados">
      <bpmn:documentation>SRS-RF007, SRS-RF009, SRS-RF010</bpmn:documentation>
      <bpmn:incoming>CAN_F07</bpmn:incoming>
      <bpmn:outgoing>CAN_F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CAN_manifestados" name="Obtener los factores manifestados desde la variedad">
      <bpmn:documentation>SRS-RF033</bpmn:documentation>
      <bpmn:incoming>CAN_F08</bpmn:incoming>
      <bpmn:outgoing>CAN_F09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CAN_deducidos" name="Recalcular los portadores deducidos del canario y sus crías">
      <bpmn:documentation>SRS-RF034</bpmn:documentation>
      <bpmn:incoming>CAN_F09</bpmn:incoming>
      <bpmn:outgoing>CAN_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CAN_mostrar" name="Registrar auditoría y mostrar la ficha">
      <bpmn:documentation>SRS-RF024</bpmn:documentation>
      <bpmn:incoming>CAN_F10</bpmn:incoming>
      <bpmn:outgoing>CAN_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CAN_fin" name="Ficha registrada o actualizada">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CAN_F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="CAN_F01" sourceRef="CAN_ficha_datos" targetRef="CAN_ficha_validar" name=""/>
    <bpmn:sequenceFlow id="CAN_F02" sourceRef="CAN_ficha_validar" targetRef="CAN_ficha_valido" name=""/>
    <bpmn:sequenceFlow id="CAN_F03" sourceRef="CAN_ficha_valido" targetRef="CAN_ficha_corrige" name="No"/>
    <bpmn:sequenceFlow id="CAN_F04" sourceRef="CAN_ficha_corrige" targetRef="CAN_ficha_datos" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">corrige</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CAN_F05" sourceRef="CAN_ficha_corrige" targetRef="CAN_ficha_cancelado" name="No"/>
    <bpmn:sequenceFlow id="CAN_F06" sourceRef="CAN_inicio" targetRef="CAN_ficha_datos" name=""/>
    <bpmn:sequenceFlow id="CAN_F07" sourceRef="CAN_ficha_valido" targetRef="CAN_guardar" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_validos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CAN_F08" sourceRef="CAN_guardar" targetRef="CAN_manifestados" name=""/>
    <bpmn:sequenceFlow id="CAN_F09" sourceRef="CAN_manifestados" targetRef="CAN_deducidos" name=""/>
    <bpmn:sequenceFlow id="CAN_F10" sourceRef="CAN_deducidos" targetRef="CAN_mostrar" name=""/>
    <bpmn:sequenceFlow id="CAN_F11" sourceRef="CAN_mostrar" targetRef="CAN_fin" name=""/>
    <bpmn:subProcess id="CAN_no_disponible" name="Sin conexión, mantenimiento o sesión expirada" triggeredByEvent="true">
      <bpmn:startEvent id="CAN_no_disponible_inicio" name="Sin conexión, mantenimiento o sesión expirada" isInterrupting="true">
        <bpmn:outgoing>CAN_no_disponible_F1</bpmn:outgoing>
        <bpmn:errorEventDefinition id="CAN_no_disponible_err" errorRef="Error_no_disponible"/>
      </bpmn:startEvent>
      <bpmn:serviceTask id="CAN_no_disponible_informar" name="Informar el motivo y no guardar cambios">
        <bpmn:documentation>SRS §2.5 (modo degradado y mantenimiento) y SEG-004 (sesión).</bpmn:documentation>
        <bpmn:incoming>CAN_no_disponible_F1</bpmn:incoming>
        <bpmn:outgoing>CAN_no_disponible_F2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="CAN_no_disponible_fin" name="Operación no realizada; sin cambios">
        <bpmn:incoming>CAN_no_disponible_F2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="CAN_no_disponible_F1" sourceRef="CAN_no_disponible_inicio" targetRef="CAN_no_disponible_informar"/>
      <bpmn:sequenceFlow id="CAN_no_disponible_F2" sourceRef="CAN_no_disponible_informar" targetRef="CAN_no_disponible_fin"/>
    </bpmn:subProcess>
    <bpmn:textAnnotation id="CAN_A_ficha">
      <bpmn:text>Errores que se informan sin guardar:
• Anillo ya usado: se indica el canario que lo usa (RF008).
• Variedad que no corresponde al sexo (RF012).
• Hembra portadora de un factor ligado al sexo (RF013).
• Portador de un factor dominante o de uno que ya manifiesta (DAT-004).
• Padre o madre de otro criadero (DAT-004).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="CAN_A_ficha_asoc" sourceRef="CAN_ficha_valido" targetRef="CAN_A_ficha" associationDirection="None"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_CAN">
    <bpmn:participant id="Participant_CAN" name="TuCriadero — Registrar o actualizar un canario" processRef="Process_CAN"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_BUS" name="Buscar y consultar la genealogía" isExecutable="false">
    <bpmn:documentation>Precondición: sesión de criador válida; todo se filtra por el criador de la sesión y un registro ajeno se trata como inexistente (RF003).
Por anillo se incluyen los dados de baja; por variedad, solo los activos. La ficha de una jaula muestra ocupantes, cruce activo e historial por fecha (RF017, RF023, RF025, RF026).</bpmn:documentation>
    <bpmn:laneSet id="BUS_lanes">
      <bpmn:lane id="BUS_persona" name="Criador">
        <bpmn:flowNodeRef>BUS_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BUS_consulta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BUS_otra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BUS_sin_resultados</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BUS_revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BUS_continua</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BUS_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BUS_sistema" name="TuCriadero (aplicación web)">
        <bpmn:flowNodeRef>BUS_buscar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BUS_hay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BUS_mostrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BUS_no_disponible</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="BUS_inicio" name="Consultar el criadero">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>BUS_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="BUS_consulta" name="Elegir anillo, correlativo, variedad o jaula y buscar">
      <bpmn:documentation>SRS-RF023, SRS-RF025, SRS-RF026</bpmn:documentation>
      <bpmn:incoming>BUS_F01</bpmn:incoming>
      <bpmn:incoming>BUS_F05</bpmn:incoming>
      <bpmn:incoming>BUS_F11</bpmn:incoming>
      <bpmn:outgoing>BUS_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="BUS_buscar" name="Buscar en el criadero según el criterio elegido">
      <bpmn:documentation>SRS-RF023, SRS-RF025, SRS-RF026</bpmn:documentation>
      <bpmn:incoming>BUS_F02</bpmn:incoming>
      <bpmn:outgoing>BUS_F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="BUS_hay" name="¿Hay coincidencias?" gatewayDirection="Diverging" default="BUS_F04">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>BUS_F03</bpmn:incoming>
      <bpmn:outgoing>BUS_F04</bpmn:outgoing>
      <bpmn:outgoing>BUS_F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="BUS_otra" name="¿Busca otra vez?" gatewayDirection="Diverging" default="BUS_F06">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>BUS_F04</bpmn:incoming>
      <bpmn:outgoing>BUS_F05</bpmn:outgoing>
      <bpmn:outgoing>BUS_F06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="BUS_sin_resultados" name="Consulta terminada sin resultados">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>BUS_F06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="BUS_mostrar" name="Mostrar la ficha o la lista de coincidencias">
      <bpmn:documentation>SRS-RF017, SRS-RF023, SRS-RF024, SRS-RF025, SRS-RF026, SRS-RF027
Una coincidencia abre la ficha; varias, la lista con año, socio y club. Las fichas enlazan padres, hermanos, medios hermanos, crías y cruces.</bpmn:documentation>
      <bpmn:incoming>BUS_F07</bpmn:incoming>
      <bpmn:incoming>BUS_F10</bpmn:incoming>
      <bpmn:outgoing>BUS_F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="BUS_revisar" name="Revisar el resultado">
      <bpmn:documentation>SRS-RF024, SRS-RF027</bpmn:documentation>
      <bpmn:incoming>BUS_F08</bpmn:incoming>
      <bpmn:outgoing>BUS_F09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="BUS_continua" name="¿Cómo continúa?" gatewayDirection="Diverging" default="BUS_F12">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>BUS_F09</bpmn:incoming>
      <bpmn:outgoing>BUS_F10</bpmn:outgoing>
      <bpmn:outgoing>BUS_F11</bpmn:outgoing>
      <bpmn:outgoing>BUS_F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="BUS_fin" name="Consulta terminada; sin cambios">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>BUS_F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="BUS_F01" sourceRef="BUS_inicio" targetRef="BUS_consulta" name=""/>
    <bpmn:sequenceFlow id="BUS_F02" sourceRef="BUS_consulta" targetRef="BUS_buscar" name=""/>
    <bpmn:sequenceFlow id="BUS_F03" sourceRef="BUS_buscar" targetRef="BUS_hay" name=""/>
    <bpmn:sequenceFlow id="BUS_F04" sourceRef="BUS_hay" targetRef="BUS_otra" name="No: «sin resultados»"/>
    <bpmn:sequenceFlow id="BUS_F05" sourceRef="BUS_otra" targetRef="BUS_consulta" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">busca_otra_vez</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BUS_F06" sourceRef="BUS_otra" targetRef="BUS_sin_resultados" name="No"/>
    <bpmn:sequenceFlow id="BUS_F07" sourceRef="BUS_hay" targetRef="BUS_mostrar" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hay_coincidencias</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BUS_F08" sourceRef="BUS_mostrar" targetRef="BUS_revisar" name=""/>
    <bpmn:sequenceFlow id="BUS_F09" sourceRef="BUS_revisar" targetRef="BUS_continua" name=""/>
    <bpmn:sequenceFlow id="BUS_F10" sourceRef="BUS_continua" targetRef="BUS_mostrar" name="Abrir un enlace">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">accion = enlace</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BUS_F11" sourceRef="BUS_continua" targetRef="BUS_consulta" name="Buscar otra vez">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">accion = buscar</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BUS_F12" sourceRef="BUS_continua" targetRef="BUS_fin" name="Terminar"/>
    <bpmn:subProcess id="BUS_no_disponible" name="Sin conexión, mantenimiento o sesión expirada" triggeredByEvent="true">
      <bpmn:startEvent id="BUS_no_disponible_inicio" name="Sin conexión, mantenimiento o sesión expirada" isInterrupting="true">
        <bpmn:outgoing>BUS_no_disponible_F1</bpmn:outgoing>
        <bpmn:errorEventDefinition id="BUS_no_disponible_err" errorRef="Error_no_disponible"/>
      </bpmn:startEvent>
      <bpmn:serviceTask id="BUS_no_disponible_informar" name="Informar el motivo y no guardar cambios">
        <bpmn:documentation>SRS §2.5 (modo degradado y mantenimiento) y SEG-004 (sesión).</bpmn:documentation>
        <bpmn:incoming>BUS_no_disponible_F1</bpmn:incoming>
        <bpmn:outgoing>BUS_no_disponible_F2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="BUS_no_disponible_fin" name="Operación no realizada; sin cambios">
        <bpmn:incoming>BUS_no_disponible_F2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="BUS_no_disponible_F1" sourceRef="BUS_no_disponible_inicio" targetRef="BUS_no_disponible_informar"/>
      <bpmn:sequenceFlow id="BUS_no_disponible_F2" sourceRef="BUS_no_disponible_informar" targetRef="BUS_no_disponible_fin"/>
    </bpmn:subProcess>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_BUS">
    <bpmn:participant id="Participant_BUS" name="TuCriadero — Buscar y consultar la genealogía" processRef="Process_BUS"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_BAJ" name="Dar de baja un canario" isExecutable="false">
    <bpmn:documentation>Precondición: sesión de criador válida; el canario es del propio criadero (RF003).
Motivos: venta, muerte u otra salida del criadero. La ficha no se borra: sigue en la genealogía y en la búsqueda por anillo (RF011, RF023, DAT-004).</bpmn:documentation>
    <bpmn:laneSet id="BAJ_lanes">
      <bpmn:lane id="BAJ_persona" name="Criador">
        <bpmn:flowNodeRef>BAJ_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BAJ_baja_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BAJ_baja_corrige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BAJ_baja_cancelado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BAJ_sistema" name="TuCriadero (aplicación web)">
        <bpmn:flowNodeRef>BAJ_baja_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BAJ_baja_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BAJ_guardar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BAJ_conservar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BAJ_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BAJ_no_disponible</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="BAJ_inicio" name="Registrar una salida del criadero">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>BAJ_F06</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="BAJ_baja_datos" name="Abrir el canario e indicar el motivo y la fecha de la baja">
      <bpmn:documentation>SRS-RF011</bpmn:documentation>
      <bpmn:incoming>BAJ_F04</bpmn:incoming>
      <bpmn:incoming>BAJ_F06</bpmn:incoming>
      <bpmn:outgoing>BAJ_F01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="BAJ_baja_validar" name="Validar el canario, el motivo y la fecha">
      <bpmn:documentation>SRS-RF011</bpmn:documentation>
      <bpmn:incoming>BAJ_F01</bpmn:incoming>
      <bpmn:outgoing>BAJ_F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="BAJ_baja_valido" name="¿Datos válidos?" gatewayDirection="Diverging" default="BAJ_F03">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>BAJ_F02</bpmn:incoming>
      <bpmn:outgoing>BAJ_F03</bpmn:outgoing>
      <bpmn:outgoing>BAJ_F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="BAJ_baja_corrige" name="¿Corrige los datos?" gatewayDirection="Diverging" default="BAJ_F05">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>BAJ_F03</bpmn:incoming>
      <bpmn:outgoing>BAJ_F04</bpmn:outgoing>
      <bpmn:outgoing>BAJ_F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="BAJ_baja_cancelado" name="Baja cancelada; canario sin cambios">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>BAJ_F05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="BAJ_guardar" name="Registrar la baja y el estado en una sola operación">
      <bpmn:documentation>SRS-RF011</bpmn:documentation>
      <bpmn:incoming>BAJ_F07</bpmn:incoming>
      <bpmn:outgoing>BAJ_F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="BAJ_conservar" name="Registrar auditoría y conservar la ficha y la genealogía">
      <bpmn:documentation>SRS-RF011, SRS-RF023, SRS-RF024</bpmn:documentation>
      <bpmn:incoming>BAJ_F08</bpmn:incoming>
      <bpmn:outgoing>BAJ_F09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="BAJ_fin" name="Baja registrada; historia conservada">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>BAJ_F09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="BAJ_F01" sourceRef="BAJ_baja_datos" targetRef="BAJ_baja_validar" name=""/>
    <bpmn:sequenceFlow id="BAJ_F02" sourceRef="BAJ_baja_validar" targetRef="BAJ_baja_valido" name=""/>
    <bpmn:sequenceFlow id="BAJ_F03" sourceRef="BAJ_baja_valido" targetRef="BAJ_baja_corrige" name="No"/>
    <bpmn:sequenceFlow id="BAJ_F04" sourceRef="BAJ_baja_corrige" targetRef="BAJ_baja_datos" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">corrige</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BAJ_F05" sourceRef="BAJ_baja_corrige" targetRef="BAJ_baja_cancelado" name="No"/>
    <bpmn:sequenceFlow id="BAJ_F06" sourceRef="BAJ_inicio" targetRef="BAJ_baja_datos" name=""/>
    <bpmn:sequenceFlow id="BAJ_F07" sourceRef="BAJ_baja_valido" targetRef="BAJ_guardar" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_validos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BAJ_F08" sourceRef="BAJ_guardar" targetRef="BAJ_conservar" name=""/>
    <bpmn:sequenceFlow id="BAJ_F09" sourceRef="BAJ_conservar" targetRef="BAJ_fin" name=""/>
    <bpmn:subProcess id="BAJ_no_disponible" name="Sin conexión, mantenimiento o sesión expirada" triggeredByEvent="true">
      <bpmn:startEvent id="BAJ_no_disponible_inicio" name="Sin conexión, mantenimiento o sesión expirada" isInterrupting="true">
        <bpmn:outgoing>BAJ_no_disponible_F1</bpmn:outgoing>
        <bpmn:errorEventDefinition id="BAJ_no_disponible_err" errorRef="Error_no_disponible"/>
      </bpmn:startEvent>
      <bpmn:serviceTask id="BAJ_no_disponible_informar" name="Informar el motivo y no guardar cambios">
        <bpmn:documentation>SRS §2.5 (modo degradado y mantenimiento) y SEG-004 (sesión).</bpmn:documentation>
        <bpmn:incoming>BAJ_no_disponible_F1</bpmn:incoming>
        <bpmn:outgoing>BAJ_no_disponible_F2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="BAJ_no_disponible_fin" name="Operación no realizada; sin cambios">
        <bpmn:incoming>BAJ_no_disponible_F2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="BAJ_no_disponible_F1" sourceRef="BAJ_no_disponible_inicio" targetRef="BAJ_no_disponible_informar"/>
      <bpmn:sequenceFlow id="BAJ_no_disponible_F2" sourceRef="BAJ_no_disponible_informar" targetRef="BAJ_no_disponible_fin"/>
    </bpmn:subProcess>
    <bpmn:textAnnotation id="BAJ_A_baja">
      <bpmn:text>Errores que se informan sin guardar:
• Falta el motivo o la fecha (RF011).
• Canario de otro criadero o ya dado de baja (RF003, DAT-001).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="BAJ_A_baja_asoc" sourceRef="BAJ_baja_valido" targetRef="BAJ_A_baja" associationDirection="None"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_BAJ">
    <bpmn:participant id="Participant_BAJ" name="TuCriadero — Dar de baja un canario" processRef="Process_BAJ"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_ACC" name="Acceder a TuCriadero y completar el perfil" isExecutable="false">
    <bpmn:documentation>El autorregistro crea solo cuentas de criador; la cuenta de administrador la crea el equipo (RF001, SEG-001).
La sesión queda limitada al criadero del usuario (RF002–RF003), expira tras 7 días de inactividad y puede cerrarse en cualquier momento (SEG-004). Socio y club se proponen por defecto al anillar (RF004).</bpmn:documentation>
    <bpmn:laneSet id="ACC_lanes">
      <bpmn:lane id="ACC_persona" name="Criador">
        <bpmn:flowNodeRef>ACC_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_cuenta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_registro_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_registro_corrige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_registro_cancelado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_ingreso_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_ingreso_reintenta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_ingreso_cancelado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_perfil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_perfil_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_perfil_corrige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_perfil_cancelado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ACC_sistema" name="TuCriadero (aplicación web)">
        <bpmn:flowNodeRef>ACC_registro_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_registro_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_crear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_ingreso_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_ingreso_resultado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_rechazado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_sesion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_perfil_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_perfil_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_guardar_perfil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACC_no_disponible</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ACC_inicio" name="Acceder a TuCriadero">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>ACC_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="ACC_cuenta" name="¿Tiene cuenta?" gatewayDirection="Diverging" default="ACC_F07">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F01</bpmn:incoming>
      <bpmn:outgoing>ACC_F07</bpmn:outgoing>
      <bpmn:outgoing>ACC_F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ACC_registro_datos" name="Ingresar nombre, correo y contraseña">
      <bpmn:documentation>SRS-RF001</bpmn:documentation>
      <bpmn:incoming>ACC_F05</bpmn:incoming>
      <bpmn:incoming>ACC_F07</bpmn:incoming>
      <bpmn:outgoing>ACC_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ACC_registro_validar" name="Validar los datos del registro">
      <bpmn:documentation>SRS-RF001</bpmn:documentation>
      <bpmn:incoming>ACC_F02</bpmn:incoming>
      <bpmn:outgoing>ACC_F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ACC_registro_valido" name="¿Datos válidos?" gatewayDirection="Diverging" default="ACC_F04">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F03</bpmn:incoming>
      <bpmn:outgoing>ACC_F04</bpmn:outgoing>
      <bpmn:outgoing>ACC_F08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ACC_registro_corrige" name="¿Corrige los datos?" gatewayDirection="Diverging" default="ACC_F06">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F04</bpmn:incoming>
      <bpmn:outgoing>ACC_F05</bpmn:outgoing>
      <bpmn:outgoing>ACC_F06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ACC_registro_cancelado" name="Registro cancelado; sin cuenta nueva">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ACC_crear" name="Crear la cuenta de criador y su criadero vacío">
      <bpmn:documentation>SRS-RF001</bpmn:documentation>
      <bpmn:incoming>ACC_F08</bpmn:incoming>
      <bpmn:outgoing>ACC_F09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="ACC_ingreso_datos" name="Ingresar el correo y la contraseña">
      <bpmn:documentation>SRS-RF002, SRS-RF003</bpmn:documentation>
      <bpmn:incoming>ACC_F09</bpmn:incoming>
      <bpmn:incoming>ACC_F10</bpmn:incoming>
      <bpmn:incoming>ACC_F14</bpmn:incoming>
      <bpmn:outgoing>ACC_F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ACC_ingreso_validar" name="Validar las credenciales y el estado de la cuenta">
      <bpmn:documentation>SRS-RF002, SRS-RF003, SRS-RF005</bpmn:documentation>
      <bpmn:incoming>ACC_F11</bpmn:incoming>
      <bpmn:outgoing>ACC_F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ACC_ingreso_resultado" name="¿Resultado?" gatewayDirection="Diverging" default="ACC_F13">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F12</bpmn:incoming>
      <bpmn:outgoing>ACC_F13</bpmn:outgoing>
      <bpmn:outgoing>ACC_F16</bpmn:outgoing>
      <bpmn:outgoing>ACC_F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ACC_ingreso_reintenta" name="¿Intenta de nuevo?" gatewayDirection="Diverging" default="ACC_F15">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F13</bpmn:incoming>
      <bpmn:outgoing>ACC_F14</bpmn:outgoing>
      <bpmn:outgoing>ACC_F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ACC_ingreso_cancelado" name="Ingreso cancelado">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ACC_rechazado" name="Acceso rechazado: cuenta desactivada">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ACC_sesion" name="Abrir la sesión con el rol y el criadero autorizados">
      <bpmn:documentation>SRS-RF002, SRS-RF003</bpmn:documentation>
      <bpmn:incoming>ACC_F17</bpmn:incoming>
      <bpmn:outgoing>ACC_F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ACC_perfil" name="¿Actualiza el socio y el club?" gatewayDirection="Diverging" default="ACC_F27">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F18</bpmn:incoming>
      <bpmn:outgoing>ACC_F24</bpmn:outgoing>
      <bpmn:outgoing>ACC_F27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ACC_perfil_datos" name="Ingresar el número de socio y el club">
      <bpmn:documentation>SRS-RF004</bpmn:documentation>
      <bpmn:incoming>ACC_F22</bpmn:incoming>
      <bpmn:incoming>ACC_F24</bpmn:incoming>
      <bpmn:outgoing>ACC_F19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ACC_perfil_validar" name="Validar los datos del perfil">
      <bpmn:documentation>SRS-RF004</bpmn:documentation>
      <bpmn:incoming>ACC_F19</bpmn:incoming>
      <bpmn:outgoing>ACC_F20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ACC_perfil_valido" name="¿Datos válidos?" gatewayDirection="Diverging" default="ACC_F21">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F20</bpmn:incoming>
      <bpmn:outgoing>ACC_F21</bpmn:outgoing>
      <bpmn:outgoing>ACC_F25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ACC_perfil_corrige" name="¿Corrige los datos?" gatewayDirection="Diverging" default="ACC_F23">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F21</bpmn:incoming>
      <bpmn:outgoing>ACC_F22</bpmn:outgoing>
      <bpmn:outgoing>ACC_F23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ACC_perfil_cancelado" name="Perfil sin cambios; acceso disponible">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ACC_guardar_perfil" name="Guardar socio y club como valores por defecto">
      <bpmn:documentation>SRS-RF004</bpmn:documentation>
      <bpmn:incoming>ACC_F25</bpmn:incoming>
      <bpmn:outgoing>ACC_F26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ACC_fin" name="Acceso disponible con sesión autorizada">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>ACC_F26</bpmn:incoming>
      <bpmn:incoming>ACC_F27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="ACC_F01" sourceRef="ACC_inicio" targetRef="ACC_cuenta" name=""/>
    <bpmn:sequenceFlow id="ACC_F02" sourceRef="ACC_registro_datos" targetRef="ACC_registro_validar" name=""/>
    <bpmn:sequenceFlow id="ACC_F03" sourceRef="ACC_registro_validar" targetRef="ACC_registro_valido" name=""/>
    <bpmn:sequenceFlow id="ACC_F04" sourceRef="ACC_registro_valido" targetRef="ACC_registro_corrige" name="No"/>
    <bpmn:sequenceFlow id="ACC_F05" sourceRef="ACC_registro_corrige" targetRef="ACC_registro_datos" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">corrige</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ACC_F06" sourceRef="ACC_registro_corrige" targetRef="ACC_registro_cancelado" name="No"/>
    <bpmn:sequenceFlow id="ACC_F07" sourceRef="ACC_cuenta" targetRef="ACC_registro_datos" name="No"/>
    <bpmn:sequenceFlow id="ACC_F08" sourceRef="ACC_registro_valido" targetRef="ACC_crear" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_validos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ACC_F09" sourceRef="ACC_crear" targetRef="ACC_ingreso_datos" name=""/>
    <bpmn:sequenceFlow id="ACC_F10" sourceRef="ACC_cuenta" targetRef="ACC_ingreso_datos" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">tiene_cuenta</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ACC_F11" sourceRef="ACC_ingreso_datos" targetRef="ACC_ingreso_validar" name=""/>
    <bpmn:sequenceFlow id="ACC_F12" sourceRef="ACC_ingreso_validar" targetRef="ACC_ingreso_resultado" name=""/>
    <bpmn:sequenceFlow id="ACC_F13" sourceRef="ACC_ingreso_resultado" targetRef="ACC_ingreso_reintenta" name="Credenciales incorrectas"/>
    <bpmn:sequenceFlow id="ACC_F14" sourceRef="ACC_ingreso_reintenta" targetRef="ACC_ingreso_datos" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reintenta</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ACC_F15" sourceRef="ACC_ingreso_reintenta" targetRef="ACC_ingreso_cancelado" name="No"/>
    <bpmn:sequenceFlow id="ACC_F16" sourceRef="ACC_ingreso_resultado" targetRef="ACC_rechazado" name="Desactivada">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">cuenta = desactivada</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ACC_F17" sourceRef="ACC_ingreso_resultado" targetRef="ACC_sesion" name="Válidas">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">credenciales_validas</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ACC_F18" sourceRef="ACC_sesion" targetRef="ACC_perfil" name=""/>
    <bpmn:sequenceFlow id="ACC_F19" sourceRef="ACC_perfil_datos" targetRef="ACC_perfil_validar" name=""/>
    <bpmn:sequenceFlow id="ACC_F20" sourceRef="ACC_perfil_validar" targetRef="ACC_perfil_valido" name=""/>
    <bpmn:sequenceFlow id="ACC_F21" sourceRef="ACC_perfil_valido" targetRef="ACC_perfil_corrige" name="No"/>
    <bpmn:sequenceFlow id="ACC_F22" sourceRef="ACC_perfil_corrige" targetRef="ACC_perfil_datos" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">corrige</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ACC_F23" sourceRef="ACC_perfil_corrige" targetRef="ACC_perfil_cancelado" name="No"/>
    <bpmn:sequenceFlow id="ACC_F24" sourceRef="ACC_perfil" targetRef="ACC_perfil_datos" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">actualizar_perfil</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ACC_F25" sourceRef="ACC_perfil_valido" targetRef="ACC_guardar_perfil" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_validos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ACC_F26" sourceRef="ACC_guardar_perfil" targetRef="ACC_fin" name=""/>
    <bpmn:sequenceFlow id="ACC_F27" sourceRef="ACC_perfil" targetRef="ACC_fin" name="No"/>
    <bpmn:subProcess id="ACC_no_disponible" name="Sin conexión o mantenimiento" triggeredByEvent="true">
      <bpmn:startEvent id="ACC_no_disponible_inicio" name="Sin conexión o mantenimiento" isInterrupting="true">
        <bpmn:outgoing>ACC_no_disponible_F1</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ACC_no_disponible_err" errorRef="Error_no_disponible"/>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ACC_no_disponible_informar" name="Informar el motivo y no guardar cambios">
        <bpmn:documentation>SRS §2.5 (modo degradado y mantenimiento) y SEG-004 (sesión).</bpmn:documentation>
        <bpmn:incoming>ACC_no_disponible_F1</bpmn:incoming>
        <bpmn:outgoing>ACC_no_disponible_F2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="ACC_no_disponible_fin" name="Operación no realizada; sin cambios">
        <bpmn:incoming>ACC_no_disponible_F2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="ACC_no_disponible_F1" sourceRef="ACC_no_disponible_inicio" targetRef="ACC_no_disponible_informar"/>
      <bpmn:sequenceFlow id="ACC_no_disponible_F2" sourceRef="ACC_no_disponible_informar" targetRef="ACC_no_disponible_fin"/>
    </bpmn:subProcess>
    <bpmn:textAnnotation id="ACC_A_registro">
      <bpmn:text>Errores que se informan sin guardar:
• Contraseña de menos de 8 caracteres (SEG-001).
• Correo ya registrado (RF002).
• Falta el nombre, el correo o la contraseña (RF001).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="ACC_A_registro_asoc" sourceRef="ACC_registro_valido" targetRef="ACC_A_registro" associationDirection="None"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_ACC">
    <bpmn:participant id="Participant_ACC" name="TuCriadero — Acceder a TuCriadero y completar el perfil" processRef="Process_ACC"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_CTA" name="Administrar las cuentas" isExecutable="false">
    <bpmn:documentation>Precondición: sesión de administrador; un criador no accede a esta función. El administrador ve los datos de registro y el estado de las cuentas, nunca los datos de los criaderos (RF006, SEG-001).
Desactivar una cuenta impide su ingreso y conserva sus datos (RF005). Toda acción administrativa se audita (SEG-003).</bpmn:documentation>
    <bpmn:laneSet id="CTA_lanes">
      <bpmn:lane id="CTA_persona" name="Administrador">
        <bpmn:flowNodeRef>CTA_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CTA_consultar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CTA_estado_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CTA_estado_corrige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CTA_estado_cancelado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CTA_sistema" name="TuCriadero (aplicación web)">
        <bpmn:flowNodeRef>CTA_listar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CTA_estado_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CTA_estado_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CTA_guardar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CTA_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CTA_no_disponible</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CTA_inicio" name="Administrar las cuentas">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>CTA_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="CTA_consultar" name="Consultar las cuentas">
      <bpmn:documentation>SRS-RF006</bpmn:documentation>
      <bpmn:incoming>CTA_F01</bpmn:incoming>
      <bpmn:outgoing>CTA_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CTA_listar" name="Listar el registro y el estado de cada cuenta">
      <bpmn:documentation>SRS-RF006</bpmn:documentation>
      <bpmn:incoming>CTA_F02</bpmn:incoming>
      <bpmn:outgoing>CTA_F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="CTA_estado_datos" name="Elegir una cuenta y su nuevo estado">
      <bpmn:documentation>SRS-RF005</bpmn:documentation>
      <bpmn:incoming>CTA_F06</bpmn:incoming>
      <bpmn:incoming>CTA_F08</bpmn:incoming>
      <bpmn:outgoing>CTA_F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CTA_estado_validar" name="Validar la cuenta y el cambio de estado">
      <bpmn:documentation>SRS-RF005</bpmn:documentation>
      <bpmn:incoming>CTA_F03</bpmn:incoming>
      <bpmn:outgoing>CTA_F04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CTA_estado_valido" name="¿Datos válidos?" gatewayDirection="Diverging" default="CTA_F05">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CTA_F04</bpmn:incoming>
      <bpmn:outgoing>CTA_F05</bpmn:outgoing>
      <bpmn:outgoing>CTA_F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="CTA_estado_corrige" name="¿Corrige los datos?" gatewayDirection="Diverging" default="CTA_F07">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CTA_F05</bpmn:incoming>
      <bpmn:outgoing>CTA_F06</bpmn:outgoing>
      <bpmn:outgoing>CTA_F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="CTA_estado_cancelado" name="Cuentas sin cambios">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CTA_F07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="CTA_guardar" name="Guardar el estado sin borrar datos y auditar">
      <bpmn:documentation>SRS-RF005</bpmn:documentation>
      <bpmn:incoming>CTA_F09</bpmn:incoming>
      <bpmn:outgoing>CTA_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CTA_fin" name="Estado de la cuenta actualizado">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CTA_F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="CTA_F01" sourceRef="CTA_inicio" targetRef="CTA_consultar" name=""/>
    <bpmn:sequenceFlow id="CTA_F02" sourceRef="CTA_consultar" targetRef="CTA_listar" name=""/>
    <bpmn:sequenceFlow id="CTA_F03" sourceRef="CTA_estado_datos" targetRef="CTA_estado_validar" name=""/>
    <bpmn:sequenceFlow id="CTA_F04" sourceRef="CTA_estado_validar" targetRef="CTA_estado_valido" name=""/>
    <bpmn:sequenceFlow id="CTA_F05" sourceRef="CTA_estado_valido" targetRef="CTA_estado_corrige" name="No"/>
    <bpmn:sequenceFlow id="CTA_F06" sourceRef="CTA_estado_corrige" targetRef="CTA_estado_datos" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">corrige</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CTA_F07" sourceRef="CTA_estado_corrige" targetRef="CTA_estado_cancelado" name="No"/>
    <bpmn:sequenceFlow id="CTA_F08" sourceRef="CTA_listar" targetRef="CTA_estado_datos" name=""/>
    <bpmn:sequenceFlow id="CTA_F09" sourceRef="CTA_estado_valido" targetRef="CTA_guardar" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_validos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CTA_F10" sourceRef="CTA_guardar" targetRef="CTA_fin" name=""/>
    <bpmn:subProcess id="CTA_no_disponible" name="Sin conexión, mantenimiento o sesión expirada" triggeredByEvent="true">
      <bpmn:startEvent id="CTA_no_disponible_inicio" name="Sin conexión, mantenimiento o sesión expirada" isInterrupting="true">
        <bpmn:outgoing>CTA_no_disponible_F1</bpmn:outgoing>
        <bpmn:errorEventDefinition id="CTA_no_disponible_err" errorRef="Error_no_disponible"/>
      </bpmn:startEvent>
      <bpmn:serviceTask id="CTA_no_disponible_informar" name="Informar el motivo y no guardar cambios">
        <bpmn:documentation>SRS §2.5 (modo degradado y mantenimiento) y SEG-004 (sesión).</bpmn:documentation>
        <bpmn:incoming>CTA_no_disponible_F1</bpmn:incoming>
        <bpmn:outgoing>CTA_no_disponible_F2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="CTA_no_disponible_fin" name="Operación no realizada; sin cambios">
        <bpmn:incoming>CTA_no_disponible_F2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="CTA_no_disponible_F1" sourceRef="CTA_no_disponible_inicio" targetRef="CTA_no_disponible_informar"/>
      <bpmn:sequenceFlow id="CTA_no_disponible_F2" sourceRef="CTA_no_disponible_informar" targetRef="CTA_no_disponible_fin"/>
    </bpmn:subProcess>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_CTA">
    <bpmn:participant id="Participant_CTA" name="TuCriadero — Administrar las cuentas" processRef="Process_CTA"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_CAT" name="Mantener el catálogo de variedades y factores" isExecutable="false">
    <bpmn:documentation>Precondición: sesión de administrador; para los criadores el catálogo es de solo lectura (RF030, SEG-001). Las 762 variedades, sus factores y su composición vienen precargados (RF028, DAT-005).
Los cambios aplican para todos los criadores y se auditan (RF032, SEG-003).</bpmn:documentation>
    <bpmn:laneSet id="CAT_lanes">
      <bpmn:lane id="CAT_persona" name="Administrador">
        <bpmn:flowNodeRef>CAT_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CAT_catalogo_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CAT_catalogo_corrige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CAT_catalogo_cancelado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CAT_sistema" name="TuCriadero (aplicación web)">
        <bpmn:flowNodeRef>CAT_catalogo_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CAT_catalogo_valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CAT_guardar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CAT_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CAT_no_disponible</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CAT_inicio" name="Mantener el catálogo">
      <bpmn:documentation>SRS-RF028, SRS-RF030</bpmn:documentation>
      <bpmn:outgoing>CAT_F06</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="CAT_catalogo_datos" name="Agregar o corregir una variedad, su composición o un factor">
      <bpmn:documentation>SRS-RF031, SRS-RF032</bpmn:documentation>
      <bpmn:incoming>CAT_F04</bpmn:incoming>
      <bpmn:incoming>CAT_F06</bpmn:incoming>
      <bpmn:outgoing>CAT_F01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CAT_catalogo_validar" name="Validar códigos, composición, herencia y uso">
      <bpmn:documentation>SRS-RF031, SRS-RF032</bpmn:documentation>
      <bpmn:incoming>CAT_F01</bpmn:incoming>
      <bpmn:outgoing>CAT_F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CAT_catalogo_valido" name="¿Datos válidos?" gatewayDirection="Diverging" default="CAT_F03">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CAT_F02</bpmn:incoming>
      <bpmn:outgoing>CAT_F03</bpmn:outgoing>
      <bpmn:outgoing>CAT_F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="CAT_catalogo_corrige" name="¿Corrige los datos?" gatewayDirection="Diverging" default="CAT_F05">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CAT_F03</bpmn:incoming>
      <bpmn:outgoing>CAT_F04</bpmn:outgoing>
      <bpmn:outgoing>CAT_F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="CAT_catalogo_cancelado" name="Catálogo sin cambios">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CAT_F05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="CAT_guardar" name="Aplicar el cambio para todos los criadores y auditar">
      <bpmn:documentation>SRS-RF032</bpmn:documentation>
      <bpmn:incoming>CAT_F07</bpmn:incoming>
      <bpmn:outgoing>CAT_F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CAT_fin" name="Catálogo actualizado">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>CAT_F08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="CAT_F01" sourceRef="CAT_catalogo_datos" targetRef="CAT_catalogo_validar" name=""/>
    <bpmn:sequenceFlow id="CAT_F02" sourceRef="CAT_catalogo_validar" targetRef="CAT_catalogo_valido" name=""/>
    <bpmn:sequenceFlow id="CAT_F03" sourceRef="CAT_catalogo_valido" targetRef="CAT_catalogo_corrige" name="No"/>
    <bpmn:sequenceFlow id="CAT_F04" sourceRef="CAT_catalogo_corrige" targetRef="CAT_catalogo_datos" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">corrige</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CAT_F05" sourceRef="CAT_catalogo_corrige" targetRef="CAT_catalogo_cancelado" name="No"/>
    <bpmn:sequenceFlow id="CAT_F06" sourceRef="CAT_inicio" targetRef="CAT_catalogo_datos" name=""/>
    <bpmn:sequenceFlow id="CAT_F07" sourceRef="CAT_catalogo_valido" targetRef="CAT_guardar" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_validos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CAT_F08" sourceRef="CAT_guardar" targetRef="CAT_fin" name=""/>
    <bpmn:subProcess id="CAT_no_disponible" name="Sin conexión, mantenimiento o sesión expirada" triggeredByEvent="true">
      <bpmn:startEvent id="CAT_no_disponible_inicio" name="Sin conexión, mantenimiento o sesión expirada" isInterrupting="true">
        <bpmn:outgoing>CAT_no_disponible_F1</bpmn:outgoing>
        <bpmn:errorEventDefinition id="CAT_no_disponible_err" errorRef="Error_no_disponible"/>
      </bpmn:startEvent>
      <bpmn:serviceTask id="CAT_no_disponible_informar" name="Informar el motivo y no guardar cambios">
        <bpmn:documentation>SRS §2.5 (modo degradado y mantenimiento) y SEG-004 (sesión).</bpmn:documentation>
        <bpmn:incoming>CAT_no_disponible_F1</bpmn:incoming>
        <bpmn:outgoing>CAT_no_disponible_F2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="CAT_no_disponible_fin" name="Operación no realizada; sin cambios">
        <bpmn:incoming>CAT_no_disponible_F2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="CAT_no_disponible_F1" sourceRef="CAT_no_disponible_inicio" targetRef="CAT_no_disponible_informar"/>
      <bpmn:sequenceFlow id="CAT_no_disponible_F2" sourceRef="CAT_no_disponible_informar" targetRef="CAT_no_disponible_fin"/>
    </bpmn:subProcess>
    <bpmn:textAnnotation id="CAT_A_catalogo">
      <bpmn:text>Errores que se informan sin guardar:
• Código de variedad duplicado (RF032).
• Eliminar una variedad asignada a algún canario (RF032).
• Composición repetida para el mismo sexo (DAT-004).
• Factor sin tipo de herencia (RF031).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="CAT_A_catalogo_asoc" sourceRef="CAT_catalogo_valido" targetRef="CAT_A_catalogo" associationDirection="None"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_CAT">
    <bpmn:participant id="Participant_CAT" name="TuCriadero — Mantener el catálogo de variedades y factores" processRef="Process_CAT"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_TEM" name="Temporada de cría (vista general)">
    <bpmndi:BPMNPlane id="Plane_TEM" bpmnElement="Collaboration_TEM">
      <bpmndi:BPMNShape id="Participant_TEM_di" bpmnElement="Participant_TEM" isHorizontal="false">
        <dc:Bounds x="40" y="150" width="1620" height="1655"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TEM_persona_di" bpmnElement="TEM_persona" isHorizontal="false">
        <dc:Bounds x="100" y="150" width="1560" height="1655"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TEM_inicio_di" bpmnElement="TEM_inicio">
