      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CRU_mostrar_di" bpmnElement="CRU_mostrar">
        <dc:Bounds x="900.0" y="1682.0" width="440" height="116"/>
      </bpmndi:BPMNShape>
