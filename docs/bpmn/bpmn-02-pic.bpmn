      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PIC_factores_di" bpmnElement="PIC_factores">
        <dc:Bounds x="900.0" y="1202.0" width="440" height="116"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PIC_mostrar_di" bpmnElement="PIC_mostrar">
        <dc:Bounds x="900.0" y="1362.0" width="440" height="116"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PIC_seguir_di" bpmnElement="PIC_seguir">
        <dc:Bounds x="220.0" y="1362.0" width="440" height="116"/>
      </bpmndi:BPMNShape>
