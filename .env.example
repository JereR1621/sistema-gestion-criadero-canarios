# Copiar como .env y completar con valores locales. El archivo .env no se sube a GitHub.
# Guía: docs/base-de-datos.md

# local | pruebas | produccion. --desde-cero solo funciona con local.
APP_ENV=local

# Instalación manual: tu MySQL local. Con Docker no cambies estas dos líneas: docker-compose.yml
# fija DB_HOST=db y DB_PORT=3306 dentro del contenedor, y esos valores tienen prioridad sobre este archivo.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tucriadero
DB_NAME_PRUEBAS=tucriadero_pruebas
DB_USER=tucriadero
DB_PASS=

# Solo con Docker: contraseña de root del MySQL del contenedor (docker compose no arranca si está vacía).
DB_ROOT_PASS=

# Cuenta de administrador que crea "php database/migrar.php --seeds".
ADMIN_CORREO=admin@tucriadero.local
ADMIN_CONTRASENA=
