      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PIC_anillos_error_di" bpmnElement="PIC_anillos_error">
        <dc:Bounds x="900.0" y="882.0" width="440" height="116"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PIC_anillos_corregir_di" bpmnElement="PIC_anillos_corregir">
        <dc:Bounds x="220.0" y="882.0" width="440" height="116"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PIC_fichas_di" bpmnElement="PIC_fichas">
