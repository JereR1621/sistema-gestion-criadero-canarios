        <di:waypoint x="1060" y="560.0"/>
        <di:waypoint x="1060" y="646.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CAT_F03_di" bpmnElement="CAT_F03">
        <di:waypoint x="1026.0" y="680"/>
        <di:waypoint x="504.0" y="680"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="984.48" y="645" width="31.519999999999982" height="29"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CAT_F04_di" bpmnElement="CAT_F04">
        <di:waypoint x="470" y="646.0"/>
        <di:waypoint x="470" y="560.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="478" y="609.0" width="31.519999999999982" height="29.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CAT_F05_di" bpmnElement="CAT_F05">
        <di:waypoint x="470" y="714.0"/>
