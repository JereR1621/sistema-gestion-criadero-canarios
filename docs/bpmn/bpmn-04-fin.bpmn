      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="FIN_no_disponible_di" bpmnElement="FIN_no_disponible" isExpanded="true">
        <dc:Bounds x="840" y="1425" width="780" height="250"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FIN_no_disponible_inicio_di" bpmnElement="FIN_no_disponible_inicio">
        <dc:Bounds x="926" y="1526" width="48" height="48"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FIN_no_disponible_informar_di" bpmnElement="FIN_no_disponible_informar">
        <dc:Bounds x="1065.0" y="1498.0" width="330" height="104"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FIN_no_disponible_fin_di" bpmnElement="FIN_no_disponible_fin">
        <dc:Bounds x="1486" y="1526" width="48" height="48"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="FIN_no_disponible_F1_di" bpmnElement="FIN_no_disponible_F1">
        <di:waypoint x="974" y="1550"/>
