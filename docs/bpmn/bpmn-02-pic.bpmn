          <dc:Bounds x="488.0" y="1538" width="285" height="80"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PIC_fin_di" bpmnElement="PIC_fin">
