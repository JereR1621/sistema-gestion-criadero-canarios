          <dc:Bounds x="137" y="686" width="230" height="28"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CAN_F06_di" bpmnElement="CAN_F06">
        <di:waypoint x="440" y="324.0"/>
        <di:waypoint x="440" y="402.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CAN_F07_di" bpmnElement="CAN_F07">
        <di:waypoint x="1154.0" y="620"/>
        <di:waypoint x="1375" y="620"/>
        <di:waypoint x="1375" y="940"/>
        <di:waypoint x="1340.0" y="940"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1272.5" y="630" width="230" height="28"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CAN_F08_di" bpmnElement="CAN_F08">
        <di:waypoint x="1120" y="998.0"/>
