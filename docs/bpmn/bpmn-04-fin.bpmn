          <dc:Bounds x="478" y="725.0" width="31.519999999999982" height="29.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FIN_F06_di" bpmnElement="FIN_F06">
        <di:waypoint x="470" y="324.0"/>
