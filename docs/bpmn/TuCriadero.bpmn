      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TEM_espera_di" bpmnElement="TEM_espera">
        <dc:Bounds x="736.0" y="656.0" width="48" height="48"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="473.59999999999997" y="615" width="254.40000000000003" height="55"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TEM_pic_di" bpmnElement="TEM_pic">
        <dc:Bounds x="550.0" y="800.0" width="420" height="140"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TEM_fin_di" bpmnElement="TEM_fin">
