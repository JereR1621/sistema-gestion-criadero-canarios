      <bpmndi:BPMNEdge id="CTA_F10_di" bpmnElement="CTA_F10">
        <di:waypoint x="1060" y="1130.0"/>
        <di:waypoint x="1060" y="1226.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="CTA_no_disponible_di" bpmnElement="CTA_no_disponible" isExpanded="true">
        <dc:Bounds x="840" y="1425" width="780" height="250"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CTA_no_disponible_inicio_di" bpmnElement="CTA_no_disponible_inicio">
        <dc:Bounds x="926" y="1526" width="48" height="48"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CTA_no_disponible_informar_di" bpmnElement="CTA_no_disponible_informar">
