        <bpmndi:BPMNLabel>
          <dc:Bounds x="478" y="915.0" width="31.519999999999982" height="29.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CTA_F08_di" bpmnElement="CTA_F08">
        <di:waypoint x="1060" y="560.0"/>
        <di:waypoint x="1060" y="582.0"/>
        <di:waypoint x="470" y="582.0"/>
        <di:waypoint x="470" y="610.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CTA_F09_di" bpmnElement="CTA_F09">
        <di:waypoint x="1060" y="904.0"/>
