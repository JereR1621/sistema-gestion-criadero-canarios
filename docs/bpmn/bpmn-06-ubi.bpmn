      <bpmndi:BPMNEdge id="UBI_F08_di" bpmnElement="UBI_F08">
        <di:waypoint x="1060" y="940.0"/>
        <di:waypoint x="1060" y="1036.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="UBI_no_disponible_di" bpmnElement="UBI_no_disponible" isExpanded="true">
