      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FIN_cierre_valido_di" bpmnElement="FIN_cierre_valido" isMarkerVisible="true">
        <dc:Bounds x="1026.0" y="646.0" width="68" height="68"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1102.0" y="640" width="192.79999999999995" height="30"/>
