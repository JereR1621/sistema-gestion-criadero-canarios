# Copiar como .env y completar con valores locales. El archivo .env no se sube a GitHub.
# Guía: docs/base-de-datos.md

# local | pruebas | produccion. --desde-cero solo funciona con local.
APP_ENV=local

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tucriadero
DB_NAME_PRUEBAS=tucriadero_pruebas
DB_USER=tucriadero
DB_PASS=

# Cuenta de administrador que crea "php database/migrar.php --seeds".
ADMIN_CORREO=admin@tucriadero.local
ADMIN_CONTRASENA=
